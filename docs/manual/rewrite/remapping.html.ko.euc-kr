<a href="../tr/rewrite/remapping.html" hreflang="tr" rel="alternate" title="T&#252;rk&#231;e">&nbsp;tr&nbsp;</a> |
<a href="../zh-cn/rewrite/remapping.html" hreflang="zh-cn" rel="alternate" title="Simplified Chinese">&nbsp;zh-cn&nbsp;</a></p>
</div>
<div class="outofdate">이 문서는 최신판 번역이 아닙니다.
            최근에 변경된 내용은 영어 문서를 참고하세요.</div>


<p>&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>
<a href="../mod/mod_rewrite.html">李몄“ 臾몄&#65533;&#65533;</a>瑜&#65533; 蹂댁땐&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;
&#65533;щℓ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ш린&#65533;&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; &#65533;쇰&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; 留&#65533;&#65533;&#65533;
&#65533;ы&#65533;⑤&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, 媛&#65533;媛&#65533;&#65533;&#65533; &#65533;대&#65533;산&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;
&#65533;ㅻ&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<div class="warning">&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 以&#65533; 留&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533; &#65533;&#65533;踰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
洹몃&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533;, &#65533;⑥&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 蹂듭&#65533;ы&#65533;&#65533;&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 遺&#65533;&#65533;щ&#65533;ｊ린蹂대&#65533;ㅻ&#65533;&#65533; &#65533;댄&#65533;댄&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 以&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</div>

</div>
<div id="quickview"><ul id="toc"><li><img alt="" src="../images/down.gif" /> <a href="#old-to-new">&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533; 寃&#65533;&#65533;쇰&#65533; (&#65533;대&#65533;)</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#old-to-new-extern">&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533; 寃&#65533;&#65533;쇰&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; (&#65533;몃&#65533;)</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#movehomedirs">&#65533;ㅻⅨ &#65533;&#65533;踰&#65533;濡&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#static-to-dynamic">&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#backward-compatibility">&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533; 蹂&#65533;寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#canonicalhost">&#65533;&#65533;洹&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#multipledirs">&#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533; 寃&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#archive-access-multiplexer">吏&#65533;由ъ&#65533;&#65533;&#65533;쇰&#65533; 遺&#65533;&#65533;곕&#65533;&#65533; &#65533;&#65533;踰&#65533;濡&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#canonicalurl">&#65533;&#65533;洹&#65533; URL</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#moveddocroot">&#65533;대&#65533;&#65533;&#65533;&#65533; <code>DocumentRoot</code></a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#fallback-resource">&#65533;&#65533;泥&#65533; &#65533;&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#rewrite-query">荑쇰━ 臾몄&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;</a></li>
</ul><h3>참고</h3><ul class="seealso"><li><a href="../mod/mod_rewrite.html">紐⑤&#65533;&#65533; 臾몄&#65533;&#65533;</a></li><li><a href="intro.html">mod_rewrite &#65533;&#65533;媛&#65533;</a></li><li><a href="access.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;</a></li><li><a href="vhosts.html">媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li><li><a href="proxy.html">&#65533;&#65533;濡&#65533;&#65533;&#65533;</a></li><li><a href="rewritemap.html">RewriteMap &#65533;ъ&#65533;⑺&#65533;&#65533;湲&#65533;</a></li><li><a href="advanced.html">怨&#65533;湲&#65533; 湲곗&#65533;&#65533;</a></li><li><a href="avoid.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 寃쎌&#65533;&#65533;</a></li></ul></div>
<div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="old-to-new" id="old-to-new">&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533; 寃&#65533;&#65533;쇰&#65533; (&#65533;대&#65533;)</a> <a title="Permanent link" href="#old-to-new" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>理&#65533;洹쇱&#65533;&#65533; <code>foo.html</code> &#65533;&#65533;&#65533;댁&#65533;瑜&#65533;
      <code>bar.html</code>濡&#65533; &#65533;대&#65533;&#65533;&#65533; 蹂&#65533;寃쏀&#65533;&#65533;怨&#65533; &#65533;댁&#65533;&#65533; URL&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;怨듯&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅺ&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
      洹몃&#65533;щ&#65533;&#65533; &#65533;댁&#65533;&#65533; URL&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;댁&#65533; &#65533;대&#65533;&#65533;&#65533; 蹂&#65533;寃쎈&#65533;&#65533; 寃&#65533;&#65533;&#65533;
      &#65533;몄&#65533;&#65533;&#65533;&#65533;吏&#65533; 紐삵&#65533;&#65533;寃&#65533; &#65533;&#65533;怨&#65533; &#65533;띠&#65533;듬&#65533;&#65533;&#65533;&#65533;. 利&#65533;, 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
      二쇱&#65533;&#65533;媛&#65533; 蹂&#65533;寃쎈&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>&#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;댁&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533; URL濡&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;쇰&#65533;
      &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine  on
RewriteRule    "^<strong>/foo</strong>\.html$"  "<strong>/bar</strong>.html" [PT]</pre>

    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="old-to-new-extern" id="old-to-new-extern">&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533; 寃&#65533;&#65533;쇰&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; (&#65533;몃&#65533;)</a> <a title="Permanent link" href="#old-to-new-extern" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;ㅼ&#65533;&#65533; 理&#65533;洹쇱&#65533;&#65533; <code>foo.html</code> &#65533;&#65533;&#65533;댁&#65533;瑜&#65533;
      <code>bar.html</code>濡&#65533; &#65533;대&#65533;&#65533;&#65533; 蹂&#65533;寃쏀&#65533;&#65533;怨&#65533; &#65533;댁&#65533;&#65533; URL&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;怨듯&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅺ&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
      洹몃&#65533;щ&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533; URL&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;&#65533;&#65533;寃&#65533; &#65533;&#65533; URL&#65533;&#65533;
      &#65533;&#65533;&#65533;ㅼ＜怨&#65533; &#65533;띠&#65533;듬&#65533;&#65533;&#65533;&#65533;. 利&#65533;, 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;移&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
      蹂&#65533;寃쎈&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;&#65533;&#65533; 蹂닿린瑜&#65533; 蹂&#65533;寃쏀&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; URL濡&#65533;&#65533;&#65533;
      HTTP 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine  on
RewriteRule    "^<strong>/foo</strong>\.html$"  "<strong>bar</strong>.html"  [<strong>R</strong>]</pre>

</dd>

<dt>&#65533;&#65533;濡&#65533;</dt>

    <dd>
    <p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; <a href="#old-to-new-intern">&#65533;대&#65533;</a>
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;議곗&#65533;&#65533;&#65533;쇰&#65533; &#65533;⑥&#65533;&#65533;&#65533;&#65533; Redirect 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;
    &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몃&#65533;遺&#65533;&#65533;&#65533;
    由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;&#65533; &#65533;④린湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

    <pre class="prettyprint lang-config">Redirect "/foo.html" "/bar.html"</pre>


    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="movehomedirs" id="movehomedirs">&#65533;ㅻⅨ &#65533;&#65533;踰&#65533;濡&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#movehomedirs" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ &#65533;&#65533;踰&#65533;濡&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;, &#65533;щ&#65533;&#65533;&#65533;ㅼ&#65533;&#65533; 遺&#65533;留&#65533;&#65533;щ&#65533;&#65533;
      &#65533;&#65533;&#65533;곗&#65533;댄&#65533;명&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 怨&#65533;&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;湲곕&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;ы&#65533;&#65533; URL&#65533;&#65533;
      &#65533;&#65533; &#65533;&#65533;踰&#65533;濡&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;吏&#65533;留&#65533;, Redirect &#65533;&#65533;&#65533;&#65533;
      RedirectMatch 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533; &#65533;&#65533;
      &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">#With mod_rewrite
RewriteEngine on
RewriteRule   "^/docs/(.+)"  "http://new.example.com/docs/$1"  [R,L]</pre>


<pre class="prettyprint lang-config">#With RedirectMatch
RedirectMatch "^/docs/(.*)" "http://new.example.com/docs/$1"</pre>


<pre class="prettyprint lang-config">#With Redirect
Redirect "/docs/" "http://new.example.com/docs/"</pre>

    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="static-to-dynamic" id="static-to-dynamic">&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;</a> <a title="Permanent link" href="#static-to-dynamic" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533; <code>foo.html</code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533;
      <code>foo.cgi</code>濡&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;/&#65533;ъ&#65533;⑹&#65533;&#65533;媛&#65533; &#65533;몄&#65533;&#65533;&#65533;&#65533;吏&#65533;
      紐삵&#65533;&#65533;&#65533;&#65533;濡&#65533; 留ㅻ&#65533;&#65533;&#65533;쎄&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>URL&#65533;&#65533; CGI &#65533;ㅽ&#65533;щ┰&#65533;몃&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;怨&#65533; &#65533;몃&#65533;ㅻ&#65533;щ&#65533;&#65533;
      <strong>cgi-script</strong>濡&#65533; 媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; CGI &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;쇰&#65533;
      &#65533;ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533;寃&#65533; &#65533;&#65533;硫&#65533; <code>/~quux/foo.html</code>&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;쇰&#65533; <code>/~quux/foo.cgi</code>&#65533;&#65533;
      &#65533;몄&#65533;濡&#65533; &#65533;댁&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteEngine  on
RewriteBase    "/~quux/"
RewriteRule    "^foo\.html$"  "foo.cgi"  [H=<strong>cgi-script</strong>]</pre>

    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="backward-compatibility" id="backward-compatibility">&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533; 蹂&#65533;寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#backward-compatibility" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p><code>document.YYYY</code>&#65533;&#65533;&#65533;&#65533;
      <code>document.XXXX</code>濡&#65533; 留&#65533;&#65533;닿렇&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;,
      &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; <code>.html</code> &#65533;&#65533;&#65533;&#65533; 臾띠&#65533;&#65533;&#65533;&#65533;
      <code>.php</code>濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;, URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;&#65533;&#65533;&#65533;寃&#65533;
      (&#65533;ъ&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533;&#65533;쇰&#65533; 議댁&#65533;&#65533;) 留&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;源&#65533;?</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533;瑜&#65533; 媛&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; 議댁&#65533;ы&#65533;&#65533;怨&#65533; &#65533;댁&#65533;&#65533;
      &#65533;&#65533;&#65533;μ&#65533;&#65533;瑜&#65533; 媛&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; 議댁&#65533;ы&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;곗&#65533;&#65533;留&#65533;
      &#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533;濡&#65533; URL&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
      洹몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ URL&#65533;&#65533; 蹂&#65533;寃쎈&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">#   backward compatibility ruleset for
#   rewriting document.html to document.php
#   when and only when document.php exists
&lt;Directory "/var/www/htdocs"&gt;
    RewriteEngine on
    RewriteBase   "/var/www/htdocs"

    RewriteCond   "$1.php"           -f
    RewriteCond   "$1.html"          !-f
    RewriteRule   "^(.*).html$"      "$1.php"
&lt;/Directory&gt;</pre>

    </dd>

    <dt>&#65533;&#65533;濡&#65533;</dt>
    <dd>
    <p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; 醫&#65533;醫&#65533; 媛&#65533;怨쇰&#65533;&#65533;&#65533;&#65533;
    湲곕&#65533;μ&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;, 洹&#65533;移&#65533; &#65533;명&#65533;몄&#65533;&#65533; &#65533;ㅽ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    &#65533;뱁&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; RewriteCond 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
    &#65533;&#65533;媛&#65533;&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; RewriteRule&#65533;&#65533; &#65533;쇱そ&#65533;&#65533; 癒쇱&#65533;&#65533; &#65533;&#65533;媛&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    &#65533;곕&#65533;쇱&#65533;&#65533; RewriteCond 吏&#65533;&#65533;&#65533;&#65533;닿&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533; $1&#65533;&#65533; &#65533;대&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; 湲곕낯 &#65533;&#65533;&#65533;쇰&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;蹂&#65533;(<code>document.html</code>)怨&#65533; &#65533;&#65533;&#65533;&#65533;
    (<code>document.php</code>) &#65533;&#65533;&#65533;쇱&#65533;&#65533; 議댁&#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;명&#65533;&#65533; &#65533;&#65533;
    &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;(&lt;Directory&gt;
    釉&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533; .htaccess &#65533;&#65533;&#65533;&#65533;)&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;ㅺ&#65533;&#65533;&#65533;&#65533;&#65533;
    <code>-f</code> 寃&#65533;&#65533;ш&#65533; &#65533;щ&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533; 寃쎈&#65533;瑜&#65533; &#65533;&#65533;&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    &#65533;&#65533;&#65533;&#65533; 以&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533; 湲곕낯&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritebase">RewriteBase</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
    &#65533;ㅼ&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="canonicalhost" id="canonicalhost">&#65533;&#65533;洹&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;</a> <a title="Permanent link" href="#canonicalhost" class="permalink">&para;</a></h2>



      <dl>
        <dt>&#65533;ㅻ&#65533;:</dt>

        <dd>&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 紐⑺&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;
        &#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ &#65533;몄&#65533;ㅽ&#65533;몃&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;
        媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;,
        <strong>example.com</strong> &#65533;&#65533;&#65533;&#65533;
        <strong>www.example.com</strong>&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533; 媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃
        &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇱&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</dd>

        <dt>&#65533;닿껐梨&#65533;:</dt>

        <dd>

<p>&#65533;대&#65533;&#65533; &#65533;닿껐&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; 醫&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533;
&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; &#65533;&#65533;怨&#65533;, 鍮&#65533;&#65533;&#65533;洹&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몄&#65533;&#65533;
<code class="directive"><a href="../mod/mod_alias.html#redirect">Redirect</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
諛곗&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">&lt;VirtualHost *:80&gt;
  ServerName undesired.example.com
  ServerAlias example.com notthis.example.com

  Redirect "/" "http://www.example.com/"
&lt;/VirtualHost&gt;

&lt;VirtualHost *:80&gt;
  ServerName www.example.com
&lt;/VirtualHost&gt;</pre>


<p><code class="directive"><a href="../mod/core.html#if">&lt;If&gt;</a></code>
吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:
(<strong>2.4 &#65533;댁&#65533;&#65533;</strong>)</p>

<pre class="prettyprint lang-config">&lt;If "%{HTTP_HOST} != 'www.example.com'"&gt;
    Redirect "/" "http://www.example.com/"
&lt;/If&gt;</pre>


<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533; &#65533;쇰&#65533;瑜&#65533; HTTPS濡&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;&#65533;&#65533;ㅻ㈃
&#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">&lt;If "%{SERVER_PROTOCOL} != 'HTTPS'"&gt;
    Redirect "/admin/" "https://www.example.com/admin/"
&lt;/If&gt;</pre>


<p>&#65533;대&#65533;&#65533; &#65533;댁&#65533;&#65533;濡&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;怨&#65533; &#65533;띕&#65533;ㅻ㈃ - &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;&#65533; &#65533;&#65533; RewriteRules &#65533;명&#65533;몄&#65533;&#65533;
&#65533;④&#65533; &#65533;ъ&#65533;⑺&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; - &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;ы&#65533;&#65533; 80&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ &#65533;ы&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533; 寃쎌&#65533;&#65533;:</p>
<pre class="prettyprint lang-config">RewriteCond "%{HTTP_HOST}"   "!^www\.example\.com" [NC]
RewriteCond "%{HTTP_HOST}"   "!^$"
RewriteCond "%{SERVER_PORT}" "!^80$"
RewriteRule "^/?(.*)"        "http://www.example.com:%{SERVER_PORT}/$1" [L,R,NE]</pre>


<p>洹몃━怨&#65533; &#65533;ы&#65533;&#65533; 80&#65533;&#65533;&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533; 寃쎌&#65533;&#65533;:</p>
<pre class="prettyprint lang-config">RewriteCond "%{HTTP_HOST}"   "!^www\.example\.com"       [NC]
RewriteCond "%{HTTP_HOST}"   "!^$"
RewriteRule "^/?(.*)"        "http://www.example.com/$1" [L,R,NE]</pre>


        <p>
        紐⑤&#65533;&#65533; &#65533;&#65533;硫&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;쇰&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533;
        &#65533;띕&#65533;ㅻ㈃ - 利&#65533;, 紐⑤&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533; 媛&#65533;&#65533;&#65533;
        <strong>example.com</strong>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
        <strong>example.com</strong>&#65533;&#65533;
        <strong>www.example.com</strong>&#65533;쇰&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;&#65533;&#65533;ㅻ㈃
        &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteCond "%{HTTP_HOST}" "!^www\."                    [NC]
RewriteCond "%{HTTP_HOST}" "!^$"
RewriteRule "^/?(.*)"      "http://www.%{HTTP_HOST}/$1" [L,R,NE]</pre>


    <p>&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; 二&#65533; &#65533;&#65533;踰&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;대&#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533;
    <code class="directive"><a href="../mod/core.html#documentroot">DocumentRoot</a></code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
    <code>.htaccess</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
        </dd>
      </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="multipledirs" id="multipledirs">&#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533; 寃&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#multipledirs" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;뱀&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;щ&#65533;&#65533; &#65533;&#65533;移&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 議댁&#65533;ы&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ,
      &#65533;&#65533;泥&#65533; &#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 李얘&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;留&#65533;&#65533;&#65533;
      理&#65533;洹쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533; 援ъ“瑜&#65533; &#65533;ы&#65533;명&#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;щ&#65533;&#65533;
      &#65533;&#65533;移&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>&#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533;,
      &#65533;대&#65533;&#65533; 怨녹&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 李얠&#65533; 紐삵&#65533;&#65533;硫&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;移&#65533;&#65533;&#65533;&#65533;&#65533; 洹몃&#65533;&#65533;濡&#65533;
      &#65533;&#65533;怨듯&#65533;&#65533;&#65533;ㅺ&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteEngine on

#   癒쇱&#65533;&#65533; dir1/&#65533;&#65533;&#65533;&#65533; 李얠&#65533;&#65533;遊&#65533;&#65533;&#65533;&#65533;&#65533;...
#   ...李얠&#65533;쇰㈃ 硫&#65533;異&#65533;怨&#65533; 留&#65533;議깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;:
RewriteCond         "%{DOCUMENT_ROOT}/<strong>dir1</strong>/%{REQUEST_URI}"  -f
RewriteRule "^(.+)" "%{DOCUMENT_ROOT}/<strong>dir1</strong>/$1"  [L]

#   &#65533;ㅼ&#65533;&#65533;&#65533;쇰&#65533; dir2/&#65533;&#65533;&#65533;&#65533; 李얠&#65533;&#65533;遊&#65533;&#65533;&#65533;&#65533;&#65533;...
#   ...李얠&#65533;쇰㈃ 硫&#65533;異&#65533;怨&#65533; 留&#65533;議깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;:
RewriteCond         "%{DOCUMENT_ROOT}/<strong>dir2</strong>/%{REQUEST_URI}"  -f
RewriteRule "^(.+)" "%{DOCUMENT_ROOT}/<strong>dir2</strong>/$1"  [L]

#   洹몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ &#65533;ㅻⅨ Alias &#65533;&#65533;&#65533;&#65533; ScriptAlias 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;깆&#65533;&#65533;
#   &#65533;&#65533;&#65533;&#65533; 怨&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
RewriteRule "^"     "-"                                          [PT]</pre>

    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="archive-access-multiplexer" id="archive-access-multiplexer">吏&#65533;由ъ&#65533;&#65533;&#65533;쇰&#65533; 遺&#65533;&#65533;곕&#65533;&#65533; &#65533;&#65533;踰&#65533;濡&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#archive-access-multiplexer" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
    <p>&#65533;뱀&#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533; &#65533;щ&#65533;&#65533; 誘몃&#65533;ш&#65533; &#65533;&#65533;&#65533;쇰ŉ, &#65533;ъ&#65533;⑹&#65533;&#65533;媛&#65533; &#65533;&#65533;移&#65533;&#65533;&#65533;
    援&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 誘몃&#65533;щ&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;瑜&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
    <p>&#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몄&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;
    援&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;⑦&#65533;⑸&#65533;&#65533;&#65533;&#65533;. IP 二쇱&#65533;&#65533; 議고&#65533;&#65533;媛&#65533; 遺&#65533;媛&#65533;&#65533;ν&#65533;&#65533;
    寃쎌&#65533;&#65533; 湲곕낯 &#65533;&#65533;踰&#65533;濡&#65533; &#65533;대갚&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    <p><code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
    吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;踰&#65533; 紐⑸&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">HostnameLookups on
RewriteEngine on
RewriteMap    multiplex         "txt:/path/to/map.mirrors"
RewriteCond  "%{REMOTE_HOST}"   "([a-z]+)$"                [NC]
RewriteRule  "^/(.*)$"          "${multiplex:<strong>%1</strong>|http://www.example.com/}$1"  [R,L]</pre>


<div class="example"><p><code>
##  map.mirrors -- 硫&#65533;&#65533;고&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 留&#65533;<br />
<br />
de        http://www.example.de/<br />
uk        http://www.example.uk/<br />
com       http://www.example.com/<br />
##EOF##
</code></p></div>
    </dd>

    <dt>&#65533;&#65533;濡&#65533;</dt>
    <dd>
    <div class="warning">&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533;
    <code class="directive"><a href="../mod/core.html#hostnamelookups">HostNameLookups</a></code>媛&#65533;
    <code>on</code>&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533;硫&#65533;, &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;뱁&#65533;&#65533;
    &#65533;깅&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 珥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</div>

    <p><code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code>
    吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몄&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; 留&#65533;吏&#65533;留&#65533;
    遺&#65533;遺&#65533;&#65533;&#65533; 援&#65533;媛&#65533; 肄&#65533;&#65533;&#65533;瑜&#65533; 罹≪&#65533;&#65533;&#65533;怨&#65533;, &#65533;ㅼ&#65533;&#65533; RewriteRule&#65533;&#65533;
    &#65533;대&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 誘몃&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;
    議고&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="canonicalurl" id="canonicalurl">&#65533;&#65533;洹&#65533; URL</a> <a title="Permanent link" href="#canonicalurl" class="permalink">&para;</a></h2>



<dl>
 <dt>&#65533;ㅻ&#65533;:</dt>

   <dd>
     <p>&#65533;쇰&#65533; &#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533;
     URL&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. 蹂댄&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;濡&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;怨&#65533; 諛고&#65533;щ&#65533;&#65533;&#65533;&#65533;
     &#65533;&#65533;洹&#65533; URL&#65533;&#65533; &#65533;&#65533;怨&#65533;, &#65533;⑥&#65533;&#65533;&#65533;, &#65533;대&#65533;&#65533;&#65533; &#65533;깆&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
     &#65533;ъ&#65533;⑹&#65533;&#65533;媛&#65533; &#65533;&#65533;泥&#65533;怨&#65533; &#65533;④&#65533; &#65533;대&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;怨듯&#65533;&#65533;&#65533;&#65533;吏&#65533;&#65533;&#65533;
     愿&#65533;怨&#65533;&#65533;&#65533;&#65533;&#65533; 理&#65533;醫&#65533;&#65533;&#65533;&#65533;쇰&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533; 二쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;以&#65533;&#65533;&#65533;
     &#65533;&#65533;洹&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
   </dd>

   <dt>&#65533;닿껐梨&#65533;:</dt>

     <dd>
       <p>紐⑤&#65533;&#65533; 鍮&#65533;&#65533;&#65533;洹&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533; HTTP 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;&#65533;
       &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;移&#65533; 蹂닿린&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533;
       &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몄&#65533;&#65533;&#65533;&#65533;
       <code>/puppies</code>&#65533;&#65533; <code>/canines</code>瑜&#65533;
       &#65533;&#65533;洹&#65533; <code>/dogs</code>濡&#65533; &#65533;&#65533;泥댄&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteRule   "^/(puppies|canines)/(.*)"    "/dogs/$2"  [R]</pre>

        </dd>

     <dt>&#65533;&#65533;濡&#65533;:</dt>
     <dd>
     &#65533;닿&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;濡&#65533; Redirect &#65533;&#65533;&#65533;&#65533; RedirectMatch 吏&#65533;&#65533;&#65533;&#65533;대&#65533;
     &#65533;&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;:

     <pre class="prettyprint lang-config">RedirectMatch "^/(puppies|canines)/(.*)" "/dogs/$2"</pre>

     </dd>
      </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="moveddocroot" id="moveddocroot">&#65533;대&#65533;&#65533;&#65533;&#65533; <code>DocumentRoot</code></a> <a title="Permanent link" href="#moveddocroot" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
<p>蹂댄&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/core.html#documentroot">DocumentRoot</a></code>&#65533;&#65533;
URL "<code>/</code>"&#65533;&#65533; 吏&#65533;&#65533;&#65533; 愿&#65533;&#65533;⑤&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;щ&#65533;&#65533; 醫&#65533;醫&#65533; &#65533;&#65533; &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533;濡&#65533; 理&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;곗&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533;
泥&#65533;&#65533;&#65533; 諛⑸Ц&#65533;&#65533;&#65533;&#65533; 諛⑸Ц&#65533;&#65533;媛&#65533; &#65533;뱀&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533;
<code>/about/</code>&#65533;쇰&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;湲곕&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
&#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>
</dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>URL <code>/</code>瑜&#65533; <code>/about/</code>&#65533;쇰&#65533;
      由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine on
RewriteRule   "^/$"  "/about/"  [<strong>R</strong>]</pre>


<p>&#65533;닿&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_alias.html#redirectmatch">RedirectMatch</a></code>
吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;щ&#65533;&#65533; 泥&#65533;由ы&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RedirectMatch "^/$" "http://example.com/about/"</pre>


<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 猷⑦&#65533;&#65533; URL留&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 利&#65533;,
<code>http://example.com/</code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;留&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;怨&#65533;
<code>http://example.com/page.html</code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
&#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;ㅼ&#65533;&#65533;濡&#65533; 臾몄&#65533;&#65533; 猷⑦&#65533;몃&#65533;&#65533; 蹂&#65533;寃쏀&#65533;&#65533; 寃쎌&#65533;&#65533; -
利&#65533;, <strong>紐⑤&#65533;&#65533;</strong> 肄&#65533;&#65533;&#65533;痢&#65533;媛&#65533; &#65533;ㅼ&#65533;&#65533;濡&#65533; &#65533;대&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; - URL&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533; 寃&#65533;蹂대&#65533;&#65533;
<code class="directive"><a href="../mod/core.html#documentroot">DocumentRoot</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
蹂&#65533;寃쏀&#65533;&#65533;嫄곕&#65533;&#65533; 紐⑤&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533; &#65533;&#65533;濡&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;
&#65533;⑥&#65533;&#65533; 醫&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
</dd>
</dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="fallback-resource" id="fallback-resource">&#65533;&#65533;泥&#65533; &#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#fallback-resource" class="permalink">&para;</a></h2>


<dl>
<dt>&#65533;ㅻ&#65533;:</dt>
<dd>&#65533;뱀&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; &#65533;ㅻ&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;⑥&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;(&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;
index.php&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;)&#65533;쇰&#65533; 泥&#65533;由ы&#65533;&#65533;怨&#65533; &#65533;띠&#65533;留&#65533;, &#65533;대&#65533;몄&#65533;&#65533;&#65533;
css &#65533;&#65533;&#65533;쇨낵 媛&#65533;&#65533;&#65533; 湲곗〈 &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>

<dt>&#65533;닿껐梨&#65533;:</dt>
<dd>
<p>踰&#65533;&#65533;&#65533; 2.2.16遺&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_dir.html#fallbackresource">FallbackResource</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">&lt;Directory "/var/www/my_blog"&gt;
  FallbackResource index.php
&lt;/Directory&gt;</pre>


<p>洹몃&#65533;щ&#65533;&#65533; &#65533;댁&#65533;&#65533; 踰&#65533;&#65533;&#65533;&#65533;&#65533; Apache&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;援&#65533; &#65533;ы&#65533;&#65533;&#65533;&#65533; &#65533;대낫&#65533;&#65533;
&#65533;&#65533; 蹂듭&#65533;≫&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;ъ&#65533;깊&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;
&#65533;명&#65533;몄&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">&lt;Directory "/var/www/my_blog"&gt;
  RewriteBase "/my_blog"

  RewriteCond "/var/www/my_blog/%{REQUEST_FILENAME}" !-f
  RewriteCond "/var/www/my_blog/%{REQUEST_FILENAME}" !-d
  RewriteRule "^"                                    "index.php" [PT]
&lt;/Directory&gt;</pre>


<p>諛&#65533;硫댁&#65533;&#65533;, &#65533;&#65533;泥&#65533;&#65533;&#65533; URI瑜&#65533; index.php&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;濡&#65533;
&#65533;&#65533;&#65533;ы&#65533;&#65533;&#65533;ㅻ㈃ &#65533;대&#65533;&#65533; RewriteRule&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;泥댄&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "(.*)" "index.php?$1" [PT,QSA]</pre>


<p>&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; <code>.htaccess</code> &#65533;&#65533;&#65533;쇰&#65533;留&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
&lt;Directory&gt; 釉&#65533;濡&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

</dd>

</dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="rewrite-query" id="rewrite-query">荑쇰━ 臾몄&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#rewrite-query" class="permalink">&para;</a></h2>


<dl>
<dt>&#65533;ㅻ&#65533;:</dt>
<dd>荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533; 媛&#65533;&#65533;&#65533; 罹≪&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥댄&#65533;&#65533;嫄곕&#65533;&#65533;
URL&#65533;&#65533; &#65533;ㅻⅨ 援ъ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;듯&#65533;⑺&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>

<dt>&#65533;닿껐梨&#65533;:</dt>
<dd>
<p>&#65533;&#65533; &#65533;뱀&#65533;&#65533;&#65533;&#65533; 留&#65533;&#65533;&#65533; &#65533;닿껐梨&#65533;&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; %2 &#65533;&#65533;李몄“&#65533;&#65533;
&#65533;④린&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; 議곌굔&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;. %1&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;(愿&#65533;&#65533;&#65533; &#65533;ㅺ&#65533;吏&#65533;)&#65533;닿&#65533;, %3&#65533;&#65533; &#65533;&#65533;癒몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 議곌굔&#65533;&#65533;
&#65533;&#65533;&#65533;곗&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 洹몃━怨&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;
'&amp;&amp;'&#65533;&#65533; &#65533;쇳&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 蹂듭&#65533;≫&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
<ul>
  <li>&#65533;&#65533; &#65533;닿껐梨&#65533;&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533;嫄고&#65533;⑸&#65533;&#65533;&#65533;&#65533;:

<pre class="prettyprint lang-config"># Remove mykey=???
RewriteCond "%{QUERY_STRING}" "(.*(?:^|&amp;))mykey=([^&amp;]*)&amp;?(.*)&amp;?$"
RewriteRule "(.*)"            "$1?%1%3"</pre>

  </li>

  <li>&#65533;&#65533; &#65533;닿껐梨&#65533;&#65533;&#65533; 罹≪&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; URL 移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;怨&#65533;
  &#65533;&#65533;癒몄&#65533; &#65533;&#65533;&#65533;&#65533; 荑쇰━瑜&#65533; '?'瑜&#65533; 異&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; 踰&#65533;由쎈&#65533;&#65533;&#65533;&#65533;:

<pre class="prettyprint lang-config"># Copy from query string to PATH_INFO
RewriteCond "%{QUERY_STRING}" "(.*(?:^|&amp;))mykey=([^&amp;]*)&amp;?(.*)&amp;?$"
RewriteRule "(.*)"            "$1/products/%2/?" [PT]</pre>

  </li>

  <li>&#65533;&#65533; &#65533;닿껐梨&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 議곌굔&#65533;&#65533;&#65533;&#65533; 罹≪&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;:

<pre class="prettyprint lang-config"># Capture the value of mykey in the query string
RewriteCond "%{QUERY_STRING}" "(.*(?:^|&amp;))mykey=([^&amp;]*)&amp;?(.*)&amp;?$"
RewriteCond "%2"              !=not-so-secret-value
RewriteRule "(.*)"            "-" [F]</pre>

  </li>

  <li>&#65533;&#65533; &#65533;닿껐梨&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533; 寃&#65533;&#65533;ㅼ&#65533;&#65533; 諛&#65533;&#65533;&#65533;濡&#65533;, URL&#65533;&#65533;&#65533;&#65533; 寃쎈&#65533;
      援ъ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;(&#65533;&#65533;留&#65533;&#65533;&#65533; PATH_INFO)瑜&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;대&#65533; 蹂듭&#65533;ы&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
<pre class="prettyprint lang-config"># The desired URL might be /products/kitchen-sink, and the script expects
# /path?products=kitchen-sink.
RewriteRule "^/?path/([^/]+)/([^/]+)" "/path?$1=$2" [PT]</pre>

  </li>
</ul>

</dd>

</dl>
</div></div>
