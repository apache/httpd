</ul><h3>참고</h3><ul class="seealso"><li><a href="../mod/mod_rewrite.html">紐⑤&#65533;&#65533; 臾몄&#65533;&#65533;</a></li><li><a href="intro.html">mod_rewrite &#65533;&#65533;媛&#65533;</a></li><li><a href="remapping.html">由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;щℓ&#65533;&#65533;</a></li><li><a href="access.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;</a></li><li><a href="vhosts.html">媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li><li><a href="proxy.html">&#65533;&#65533;濡&#65533;&#65533;&#65533;</a></li><li><a href="advanced.html">怨&#65533;湲&#65533; 湲곗&#65533;&#65533;</a></li><li><a href="avoid.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 寃쎌&#65533;&#65533;</a></li><li><a href="#comments_section">Comments</a></li></ul></div>
<div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="introduction" id="introduction">&#65533;&#65533;媛&#65533;</a> <a title="Permanent link" href="#introduction" class="permalink">&para;</a></h2>
    

   <p>
   <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
   <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code> &#65533;&#65533;&#65533;&#65533;
   <code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code> 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;
   而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533; &#65533;⑥&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
   &#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;留&#65533;&#65533;쇰&#65533;&#65533;&#65533; &#65533;&#65533;臾&#65533; 蹂듭&#65533;≫&#65533;&#65533;嫄곕&#65533;&#65533; &#65533;&#65533;臾&#65533; &#65533;&#65533;臾명&#65533;&#65533;&#65533;&#65533;
   &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 議고&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533;&#65533;&#65533;
   &#65533;&#65533;&#65533;대&#65533;&#65533;怨&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
   李몄“ 臾몄&#65533;&#65533;&#65533;&#65533; &#65533;닿굅&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

   <p><code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
   吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; 援щЦ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteMap <em>MapName</em> <em>MapType</em>:<em>MapSource</em>
</pre>


    <p><a id="mapfunc" name="mapfunc"><em>MapName</em></a>&#65533;&#65533;
    留듭&#65533;&#65533; &#65533;&#65533;&#65533;뱁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;대ŉ, &#65533;댄&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;
    &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 援щЦ&#65533;&#65533; &#65533;듯&#65533;&#65533; 留듭&#65533;&#65533; &#65533;&#65533;&#65533;щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

    <p class="indent">
      <strong>
        <code>${</code> <em>MapName</em> <code>:</code> <em>LookupKey</em>
        <code>}</code> <br /> <code>${</code> <em>MapName</em> <code>:</code>
        <em>LookupKey</em> <code>|</code> <em>DefaultValue</em> <code>}</code>
      </strong>
    </p>

    <p>&#65533;대&#65533;ы&#65533;&#65533; 援ъ“媛&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;硫&#65533; 留&#65533; <em>MapName</em>&#65533;&#65533;
      議고&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;&#65533; <em>LookupKey</em>媛&#65533; 寃&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ㅺ&#65533;
      諛&#65533;寃щ&#65533;&#65533;硫&#65533; 留&#65533; &#65533;⑥&#65533;&#65533; 援ъ“&#65533;&#65533; <em>SubstValue</em>濡&#65533;
      &#65533;&#65533;泥대&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ㅻ&#65533;&#65533; 李얠&#65533; 紐삵&#65533;&#65533;硫&#65533; <em>DefaultValue</em>濡&#65533;
      &#65533;&#65533;泥대&#65533;&#65533;嫄곕&#65533;&#65533;, <em>DefaultValue</em>媛&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;
      寃쎌&#65533;&#65533; 鍮&#65533; 臾몄&#65533;&#65533;&#65533;대&#65533; &#65533;&#65533;泥대&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533;
      <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>
    <pre class="prettyprint lang-config">RewriteMap examplemap "txt:/path/to/file/map.txt"</pre>

    <p>洹몃&#65533;щ㈃ <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;&#65533;&#65533;
      &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533; 留듭&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>
      <pre class="prettyprint lang-config">RewriteRule "^/ex/(.*)" "${examplemap:$1}"</pre>


<p>留듭&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;臾닿&#65533;&#65533;&#65533; 李얠&#65533; 紐삵&#65533;&#65533; 寃쎌&#65533;곕&#65533;&#65533; &#65533;&#65533;鍮&#65533;&#65533;&#65533;&#65533;&#65533; 湲곕낯媛&#65533;&#65533;&#65533;
吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "^/ex/(.*)" "${examplemap:$1|/not_found.html}"</pre>


<div class="note"><h3>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 諛&#65533; .htaccess 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;</h3>
<p>
<code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
<code class="directive"><a href="../mod/core.html#directory">&lt;Directory&gt;</a></code> &#65533;뱀&#65533;&#65533;&#65533;대&#65533;&#65533;
<code>.htaccess</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;踰&#65533; &#65533;&#65533;&#65533;&#65533;
媛&#65533;&#65533;&#65533;&#65533;몄&#65533;ㅽ&#65533;&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; 留듭&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;쇰&#65533;&#65533; &#65533;&#65533;&#65533;깅&#65533;&#65533; 留듭&#65533;&#65533;
&#65533;대&#65533;&#65533; 踰&#65533;&#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>怨&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code> 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; 踰&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <strong>&#65533;&#65533;&#65533;&#65533;</strong>&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; 肉&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
</div>

<p>&#65533;ㅼ&#65533;&#65533; &#65533;뱀&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; <em>MapType</em>&#65533;&#65533;
&#65533;ㅻ&#65533;&#65533;&#65533;怨&#65533; 媛&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;怨듯&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
  </div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="int" id="int">int: &#65533;대&#65533; &#65533;⑥&#65533;&#65533;</a> <a title="Permanent link" href="#int" class="permalink">&para;</a></h2>
    

    <p>MapType&#65533;&#65533; <code>int</code>&#65533;&#65533; 寃쎌&#65533;&#65533; MapSource&#65533;&#65533; &#65533;ъ&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533;
    &#65533;대&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
    &#65533;⑥&#65533;&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;깆&#65533;&#65533;&#65533;&#65533;
    <code>ap_register_rewrite_mapfunc</code> API瑜&#65533; &#65533;깅&#65533;&#65533;&#65533;&#65533;&#65533;
    異&#65533;媛&#65533; &#65533;대&#65533; &#65533;⑥&#65533;&#65533;瑜&#65533; &#65533;&#65533;怨듯&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    湲곕낯&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;怨듬&#65533;&#65533;&#65533;&#65533; &#65533;⑥&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:
    </p>

    <ul>
      <li><strong>toupper</strong>:<br />
             &#65533;ㅻ&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;臾몄&#65533;&#65533;濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
      <li><strong>tolower</strong>:<br />
             &#65533;ㅻ&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;臾몄&#65533;&#65533;濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
      <li><strong>escape</strong>:<br />
             &#65533;ㅼ&#65533;&#65533; &#65533;뱀&#65533;&#65533; 臾몄&#65533;&#65533;瑜&#65533; 16吏&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;⑹&#65533;쇰&#65533; 蹂&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
      <li><strong>unescape</strong>:<br />
             &#65533;ㅼ&#65533;&#65533; 16吏&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;⑹&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;뱀&#65533;&#65533; 臾몄&#65533;&#65533;濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
    </ul>

    <p>
    &#65533;대&#65533;ы&#65533;&#65533; &#65533;⑥&#65533;&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;ㅻ㈃ int &#65533;⑥&#65533;&#65533;瑜&#65533; 李몄“&#65533;&#65533;&#65533;&#65533;
    <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>&#65533;&#65533;
    &#65533;&#65533;&#65533;깊&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;:
    </p>

   <p><strong>URI瑜&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;臾몄&#65533;&#65533; 踰&#65533;&#65533;&#65533;&#65533;쇰&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;</strong></p>
    <pre class="prettyprint lang-config">RewriteMap lc int:tolower
RewriteRule "(.*)" "${lc:$1}" [R]</pre>


    <div class="note">
    <p>&#65533;ш린&#65533;&#65533; &#65533;&#65533;怨듬&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533; 紐⑹&#65533;&#65533;&#65533;쇰&#65533;留&#65533; &#65533;&#65533;怨듬&#65533;&#65533;硫&#65533;
    沅&#65533;&#65533;&#65533; &#65533;ы&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;臾몄&#65533;&#65533; 援щ&#65533; &#65533;&#65533;&#65533;&#65533;
    留&#65533;&#65533;ㅻ&#65533;ㅻ㈃ &#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_speling.html">mod_speling</a></code> &#65533;ъ&#65533;⑹&#65533;&#65533;
    怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
    </p>
    </div>

  </div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="txt" id="txt">txt: &#65533;쇰&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 留&#65533;</a> <a title="Permanent link" href="#txt" class="permalink">&para;</a></h2>
    

    <p>MapType&#65533;&#65533; <code>txt</code>&#65533;&#65533; 寃쎌&#65533;&#65533; MapSource&#65533;&#65533;
    &#65533;&#65533; 以&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 怨듬갚&#65533;쇰&#65533; 援щ&#65533;&#65533;&#65533; &#65533;&#65533;/媛&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑦&#65533;&#65533;&#65533;&#65533;
    &#65533;쇰&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 留ㅽ&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 寃쎈&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; '#' 臾몄&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 二쇱&#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; &#65533;&#65533;
    &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;&#65533;⑦&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533; 援щЦ&#65533;&#65533;
    媛&#65533;吏&#65533;&#65533;&#65533;&#65533;&#65533;:</p>

    <div class="example"><p><code>
      # 二쇱&#65533;&#65533; 以&#65533;<br />
      <strong><em>MatchingKey</em> <em>SubstValue</em></strong><br />
      <strong><em>MatchingKey</em> <em>SubstValue</em></strong> # 二쇱&#65533;&#65533;<br />
    </code></p></div>

    <p><code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>&#65533;&#65533;
    &#65533;몄&#65533;&#65533;&#65533;硫&#65533; &#65533;몄&#65533;&#65533;媛&#65533; 以&#65533;&#65533;&#65533; 泥&#65533; 踰&#65533;吏&#65533; &#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533;,
    諛&#65533;寃щ&#65533;&#65533;硫&#65533; 移&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, 湲곗&#65533;듯&#65533;&#65533;湲&#65533; &#65533;ъ&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533; ID濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>
<p><strong>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; ID濡&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;</strong></p>
    <pre class="prettyprint lang-config">RewriteMap product2id "txt:/etc/apache2/productmap.txt"
RewriteRule "^/product/(.*)" "/prods.php?id=${product2id:$1|NOTFOUND}" [PT]</pre>


    <p>&#65533;ш린&#65533;&#65533; <code>prods.php</code> &#65533;ㅽ&#65533;щ┰&#65533;몃&#65533;&#65533; 議고&#65533;&#65533; 留듭&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 李얠&#65533; 紐삵&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; <code>id=NOTFOUND</code> &#65533;몄&#65533;&#65533;瑜&#65533;
    諛&#65533;&#65533;쇰㈃ &#65533;대&#65533;산&#65533; &#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;怨&#65533; &#65533;&#65533;&#65533;ㅺ&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p><code>/etc/apache2/productmap.txt</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533;
    &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

    <div class="example"><h3>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; ID濡&#65533;&#65533;&#65533; 留&#65533;</h3><p><code>
##<br />
##  productmap.txt - &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; ID濡&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;&#65533;<br />
##<br />
<br />
television 993<br />
stereo     198<br />
fishingrod 043<br />
basketball 418<br />
telephone  328
    </code></p></div>

    <p>&#65533;곕&#65533;쇱&#65533;&#65533; <code>http://example.com/product/television</code>&#65533;&#65533;
    &#65533;&#65533;泥&#65533;&#65533;&#65533;硫&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
    &#65533;&#65533;&#65533;⑸&#65533;&#65533;怨&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;쇰&#65533;
    <code>/prods.php?id=993</code>&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <div class="note"><h3>李멸&#65533;: .htaccess &#65533;&#65533;&#65533;&#65533;</h3>
    二쇱&#65533;댁&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533;&#65533;몄&#65533;ㅽ&#65533;&#65533; 踰&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;濡&#65533;
    &#65533;&#65533;&#65533;깅&#65533;&#65533;&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. <code>.htaccess</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;
    怨&#65533;&#65533;&#65533;&#65533;대&#65533;쇰㈃, 臾댁&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;⑦&#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
    &#65533;щ&#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;嫄고&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;:
    <pre class="prettyprint lang-config">RewriteRule "^product/(.*)" "/prods.php?id=${product2id:$1|NOTFOUND}" [PT]</pre>

    </div>

    <div class="note"><h3>罹&#65533;&#65533;&#65533;&#65533;&#65533; 議고&#65533;&#65533;</h3>
    <p>
    議고&#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; <code>mtime</code>(&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;媛&#65533;)&#65533;&#65533;
    蹂&#65533;寃쎈&#65533;&#65533;嫄곕&#65533;&#65533; httpd &#65533;&#65533;踰&#65533;媛&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;源&#65533;吏&#65533; httpd&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
    罹&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; 留&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533; 留듭&#65533;&#65533;
    &#65533;깅&#65533;μ&#65533;&#65533; &#65533;μ&#65533;&#65533;&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    </p>
    </div>

  </div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="rnd" id="rnd">rnd: 臾댁&#65533;&#65533;&#65533;&#65533; &#65533;쇰&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533;</a> <a title="Permanent link" href="#rnd" class="permalink">&para;</a></h2>
    

    <p>MapType&#65533;&#65533; <code>rnd</code>&#65533;&#65533; 寃쎌&#65533;&#65533; MapSource&#65533;&#65533; &#65533;쇰&#65533;
    &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 留ㅽ&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 寃쎈&#65533;&#65533;대ŉ, 媛&#65533; 以&#65533;&#65533;&#65533;&#65533;&#65533;
    &#65533;ㅼ&#65533;&#65533; <code>|</code>濡&#65533; 援щ&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    &#65533;ㅺ&#65533; &#65533;쇱&#65533;&#65533;&#65533;硫&#65533; &#65533;&#65533; 媛&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, 由щ&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;瑜&#65533; &#65533;듯&#65533;&#65533; 臾댁&#65533;&#65533;&#65533;&#65533; 遺&#65533;&#65533;&#65533; 遺&#65533;&#65533;곗&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇨낵 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    &#65533;대&#65533;몄&#65533;&#65533;&#65533; 'static' &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;〓&#65533;&#65533;怨&#65533;,
    &#65533;&#65533;癒몄&#65533;&#65533;&#65533; 'dynamic' &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;〓&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <div class="example"><h3>&#65533;ъ&#65533;&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;&#65533;</h3><p><code>
##<br />
##  map.txt -- &#65533;ъ&#65533;&#65533;&#65533;&#65533; 留&#65533;<br />
##<br />
<br />
static   www1|www2|www3|www4<br />
dynamic  www5|www6
    </code></p></div>
<p><strong>&#65533;ㅼ&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;</strong></p>
    <pre class="prettyprint lang-config">RewriteMap servers "rnd:/path/to/file/map.txt"

RewriteRule "^/(.*\.(png|gif|jpg))" "http://${servers:static}/$1"  [NC,P,L]
RewriteRule "^/(.*)"                "http://${servers:dynamic}/$1" [P,L]</pre>


    <p>&#65533;곕&#65533;쇱&#65533;&#65533; &#65533;대&#65533;몄&#65533;媛&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;怨&#65533; &#65533;&#65533; 洹&#65533;移&#65533; 以&#65533; 泥&#65533; 踰&#65533;吏멸&#65533;
    &#65533;쇱&#65533;&#65533;&#65533;硫&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>&#65533;&#65533;
    留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; <code>static</code>&#65533;&#65533; 議고&#65533;&#65533;&#65533;&#65533;怨&#65533;
    吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;濡&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;踰&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;瑜&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;대&#65533;ㅻ㈃(&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;
    &#65533;&#65533;踰&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533; 留&#65533;&#65533;&#65533; 硫&#65533;紐⑤━瑜&#65533; 媛&#65533;吏&#65533;怨&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 留&#65533;&#65533;&#65533;
    &#65533;&#65533;泥&#65533;&#65533;&#65533; 泥&#65533;由ы&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;) 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;踰&#65533;瑜&#65533;
    &#65533;&#65533; 留&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댄&#65533;&#65533;硫&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <div class="example"><p><code>
static   www1|www1|www2|www3|www4
    </code></p></div>

  </div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="dbm" id="dbm">dbm: DBM &#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#dbm" class="permalink">&para;</a></h2>
    

    <p>MapType&#65533;&#65533; <code>dbm</code>&#65533;&#65533; 寃쎌&#65533;&#65533; MapSource&#65533;&#65533;
    留ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;/媛&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑦&#65533;&#65533;&#65533;&#65533; DBM &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;&#65533;
    &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 寃쎈&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533; <code>txt</code>
    留듦낵 &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533;留&#65533;, DBM&#65533;&#65533; &#65533;몃&#65533;깆&#65533;깅&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533; 諛&#65533;硫&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; 洹몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533; &#65533;⑥&#65533;&#65533; 鍮&#65533;由&#65533;&#65533;&#65533;&#65533;&#65533;.
    &#65533;대&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533; 鍮&#65533;瑜닿&#65533; &#65533;&#65533;洹쇳&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;뱀&#65533;&#65533; dbm &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

 <pre class="prettyprint lang-config">RewriteMap examplemap "dbm=sdbm:/etc/apache/mapfile.dbm"</pre>


    <p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code>sdbm</code>, <code>gdbm</code>,
    <code>ndbm</code> &#65533;&#65533;&#65533;&#65533; <code>db</code>&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    洹몃&#65533;щ&#65533;&#65533; httpd &#65533;&#65533;泥닿&#65533; 鍮&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533; 寃&#65533;怨&#65533; &#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533;
    &#65533;щ&#65533;瑜&#65533; DBM &#65533;쇱&#65533;대&#65533;&#65533;щ━瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;誘&#65533;濡&#65533; Apache HTTP Server&#65533;&#65533;
    &#65533;④&#65533; &#65533;&#65533;怨듬&#65533;&#65533;&#65533;&#65533; <a href="../programs/httxt2dbm.html">httxt2dbm</a>
    &#65533;&#65533;&#65533;몃━&#65533;곕&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 醫&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>dbm &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;ㅻ㈃ 癒쇱&#65533;&#65533; <a href="#txt">txt</a>
    &#65533;뱀&#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;
    <code>httxt2dbm</code>&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<div class="example"><p><code>
$ httxt2dbm -i mapfile.txt -o mapfile.map
</code></p></div>

<p>洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533; 寃곌낵 &#65533;&#65533;&#65533;쇱&#65533;&#65533; 李몄“&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteMap mapname "dbm:/etc/apache/mapfile.map"</pre>


<div class="note">
<p>&#65533;쇰&#65533; dbm &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 怨듯&#65533;&#65533; 湲곕낯 &#65533;대&#65533;&#65533;&#65533; 媛&#65533;吏&#65533; &#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;깅&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; <code>mapfile.map.dir</code>怨&#65533;
<code>mapfile.map.pag</code>&#65533;쇰&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
&#65533;닿&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;대ŉ <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533; 湲곕낯 &#65533;대&#65533;&#65533;&#65533; <code>mapfile.map</code>留&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;
&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
</div>

<div class="note"><h3>罹&#65533;&#65533;&#65533;&#65533;&#65533; 議고&#65533;&#65533;</h3>
<p>
議고&#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; <code>mtime</code>(&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;媛&#65533;)&#65533;&#65533;
蹂&#65533;寃쎈&#65533;&#65533;嫄곕&#65533;&#65533; httpd &#65533;&#65533;踰&#65533;媛&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;源&#65533;吏&#65533; httpd&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
罹&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; 留&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533; 留듭&#65533;&#65533;
&#65533;깅&#65533;μ&#65533;&#65533; &#65533;μ&#65533;&#65533;&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
</p>
</div>

  </div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="prg" id="prg">prg: &#65533;몃&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;&#65533;</a> <a title="Permanent link" href="#prg" class="permalink">&para;</a></h2>

    <p>MapType&#65533;&#65533; <code>prg</code>&#65533;&#65533; 寃쎌&#65533;&#65533; MapSource&#65533;&#65533;
    留ㅽ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;怨듯&#65533;&#65533; &#65533;ㅽ&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533;
    寃쎈&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533; 而댄&#65533;&#65533;&#65533;쇰&#65533;&#65533; 諛&#65533;&#65533;대&#65533;&#65533;由&#65533; &#65533;&#65533;&#65533;쇱&#65533;닿굅&#65533;&#65533;
    Python&#65533;대&#65533;&#65533; Perl怨&#65533; 媛&#65533;&#65533;&#65533; &#65533;명&#65533;고&#65533;&#65533;由ы&#65533;&#65533; &#65533;몄&#65533;댁&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; &#65533;&#65533;
    &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; Apache HTTP Server媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533; 踰&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;硫&#65533;, <code>STDIN</code>怨&#65533; <code>STDOUT</code>&#65533;&#65533;
    &#65533;듯&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;吏&#65533;怨&#65533; &#65533;듭&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 媛&#65533; 留&#65533; &#65533;⑥&#65533;&#65533; 議고&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
    &#65533;ㅺ&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; <code>STDIN</code>&#65533;&#65533; 湲곕&#65533;&#65533;&#65533;怨&#65533; 洹&#65533; &#65533;ㅼ&#65533;&#65533;
    以&#65533;諛&#65533;轅&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; <code>STDIN</code>&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533; 以&#65533;&#65533;&#65533; &#65533;쎄&#65533;(以&#65533;諛&#65533;轅&#65533; &#65533;ы&#65533;&#65533;) &#65533;&#65533;&#65533;듭&#65533;&#65533;
    <code>STDOUT</code>&#65533;&#65533; 以&#65533;諛&#65533;轅&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 以&#65533;濡&#65533;
    &#65533;&#65533;&#65533;깊&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 以&#65533;諛&#65533;轅&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;吏&#65533;
    &#65533;&#65533;&#65533;쇰ŉ, 以&#65533;諛&#65533;轅&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; &#65533;ㅺ&#65533; 諛&#65533;寃щ&#65533;&#65533;硫&#65533; 議고&#65533;&#65533;媛&#65533;
    &#65533;ㅽ&#65533;⑦&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 議고&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇰㈃ 留&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533;
    &#65533;&#65533; 臾몄&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; "<code>NULL</code>"&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 鍮&#65533;援&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;臾몄&#65533;&#65533;瑜&#65533; 援щ&#65533;&#65533;&#65533;吏&#65533;
    &#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533; "null", "Null" &#65533;깅&#65533;&#65533; &#65533;ㅽ&#65533;⑦&#65533;&#65533; 議고&#65533;&#65533;濡&#65533;
    泥&#65533;由щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 寃곌낵&#65533;&#65533;&#65533;쇰&#65533; 留ㅽ&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;쇰&#65533;
    由ы&#65533;곕&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; "NULL"&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 遺&#65533;媛&#65533;&#65533;ν&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; <code>STDERR</code>&#65533;&#65533; httpd 遺&#65533;紐&#65533;
    &#65533;&#65533;濡&#65533;&#65533;몄&#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;誘&#65533;濡&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; <code>STDERR</code>&#65533;&#65533;
    &#65533;곕&#65533;&#65533; 紐⑤&#65533;&#65533; 寃&#65533;&#65533;&#65533; httpd&#65533;&#65533; &#65533;&#65533;泥&#65533; &#65533;ㅻ&#65533; 異&#65533;&#65533;κ낵 媛&#65533;&#65533;&#65533; 怨&#65533;(&#65533;쇰&#65533;&#65533;&#65533;&#65533;쇰&#65533;
    <code class="directive"><a href="../mod/core.html#errorlog">ErrorLog</a></code>)&#65533;&#65533;
    湲곕&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;몃&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriteengine">RewriteEngine</a></code>&#65533;&#65533;
    <code>on</code>&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>湲곕낯&#65533;&#65533;&#65533;쇰&#65533; &#65533;몃&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; httpd瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    user:group&#65533;쇰&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533; UNIX &#65533;&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>&#65533;&#65533;
    &#65533;&#65533; 踰&#65533;吏&#65533; &#65533;몄&#65533;&#65533;濡&#65533; <code>username:groupname</code> &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;
    &#65533;ъ&#65533;⑹&#65533;&#65533; &#65533;대&#65533;怨&#65533; 洹몃９ &#65533;대&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;&#65533;&#65533; 蹂&#65533;寃쏀&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; 湲곕&#65533;μ&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;④낵&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;듭&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    <code>rewrite-map</code> 裕ㅽ&#65533;&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    裕ㅽ&#65533;&#65533;&#65533;&#65533; 硫&#65533;而ㅻ&#65533;&#65533;利&#65533;怨&#65533; &#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; <code class="directive"><a href="../mod/core.html#mutex">Mutex</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533; 援ъ&#65533;깊&#65533;&#65533; &#65533;&#65533;
    &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;ш린&#65533;&#65533; &#65533;&#65533;泥&#65533; URI&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 諛&#65533;以&#65533;濡&#65533; &#65533;&#65533;泥댄&#65533;&#65533;&#65533;&#65533;
    媛&#65533;&#65533;⑦&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p><strong>&#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;</strong></p>
    <pre class="prettyprint lang-config">RewriteMap d2u "prg:/www/bin/dash2under.py" apache:apache
RewriteRule "-" "${d2u:%{REQUEST_URI}}"</pre>


    <p><strong>dash2under.py</strong></p>
    <pre class="prettyprint lang-python">#!/usr/bin/env python3
import sys

for line in sys.stdin:
    print(line.strip().replace('-', '_'), flush=True)</pre>


<div class="note"><h3>二쇱&#65533;&#65533;!</h3>
<ul>
<li>&#65533;ъ&#65533;&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533; &#65533;&#65533; 媛&#65533;&#65533;⑦&#65533;&#65533;寃&#65533; &#65533;&#65533;吏&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
&#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; 硫&#65533;異&#65533;硫&#65533; httpd媛&#65533; 留듭&#65533;&#65533; &#65533;&#65533;&#65533;듭&#65533;&#65533; 臾댄&#65533;&#65533;&#65533;&#65533; 湲곕&#65533;ㅻ━寃&#65533; &#65533;&#65533;怨&#65533;,
&#65533;대&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; httpd媛&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듯&#65533;&#65533;吏&#65533; 紐삵&#65533;&#65533;寃&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
<li>&#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533;&#65533;&#65533; 踰&#65533;&#65533;쇰&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533; Python &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
<code>print()</code>&#65533;&#65533; <code>flush=True</code>瑜&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;&#65533;&#65533;
&#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 踰&#65533;&#65533;쇰&#65533;&#65533;&#65533; I/O&#65533;&#65533; httpd媛&#65533; 異&#65533;&#65533;μ&#65533;&#65533; 湲곕&#65533;ㅻ━寃&#65533;
&#65533;&#65533;誘&#65533;濡&#65533; 硫&#65533;異&#65533;寃&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
<li>&#65533;&#65533;踰&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; 蹂듭&#65533;щ낯&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;肉&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
紐⑤&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 蹂&#65533;紐⑹&#65533;&#65533; &#65533;듦낵&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. 留&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;몄&#65533;ㅻ&#65533;&#65533; &#65533;듦낵&#65533;댁&#65533;&#65533; &#65533;&#65533;嫄곕&#65533;&#65533; &#65533;ㅽ&#65533;щ┰&#65533;&#65533; &#65533;&#65533;泥닿&#65533; 留ㅼ&#65533;&#65533; &#65533;&#65533;由&#65533;
寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;뱁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 珥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</li>
<li>留ㅽ&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; 醫&#65533;猷&#65533;&#65533;&#65533;硫&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
&#65533;&#65533;踰&#65533;媛&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;源&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 議고&#65533;&#65533;媛&#65533; &#65533;ㅽ&#65533;⑦&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
<li>留ㅽ&#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; 愿&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;닿&#65533; 蹂&#65533;寃쎈&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;щ&#65533;&#65533;&#65533;
愿&#65533;怨&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;(graceful &#65533;&#65533;&#65533;&#65533; 湲고&#65533;&#65533;) &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 醫&#65533;猷&#65533;&#65533;&#65533;怨&#65533;
&#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 醫&#65533;猷&#65533; &#65533;&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;&#65533; <code>SIGTERM</code>&#65533;&#65533;
&#65533;&#65533;&#65533;〓&#65533;&#65533;硫&#65533;, 3珥&#65533; &#65533;대&#65533;댁&#65533;&#65533; 醫&#65533;猷&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃
<code>SIGKILL</code>&#65533;&#65533; &#65533;&#65533;&#65533;〓&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</li>
</ul>
</div>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="dbd" id="dbd">dbd &#65533;&#65533;&#65533;&#65533; fastdbd: SQL 荑쇰━</a> <a title="Permanent link" href="#dbd" class="permalink">&para;</a></h2>
    

    <p>MapType&#65533;&#65533; <code>dbd</code> &#65533;&#65533;&#65533;&#65533; <code>fastdbd</code>&#65533;&#65533;
    寃쎌&#65533;&#65533; MapSource&#65533;&#65533; &#65533;⑥&#65533;&#65533; &#65533;몄&#65533;&#65533;瑜&#65533; 諛&#65533;&#65533;&#65533; &#65533;⑥&#65533;&#65533; 媛&#65533;&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    SQL SELECT 臾몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; 臾몄&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃ &#65533;щ&#65533;瑜&#65533; &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;ㅻ&#65533;&#65533; 媛&#65533;由ы&#65533;ㅻ&#65533;&#65533;濡&#65533;
    <code class="module"><a href="../mod/mod_dbd.html">mod_dbd</a></code>瑜&#65533; 援ъ&#65533;깊&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; MapType&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 媛&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    <code>dbd</code> MapType&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; 媛&#65533; 留&#65533; &#65533;&#65533;泥&#65533;留&#65533;&#65533;&#65533;
    荑쇰━媛&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533;怨&#65533;, <code>fastdbd</code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;
    &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;&#65533; 議고&#65533;&#65533;媛&#65533; &#65533;대&#65533;&#65533;&#65533;&#65533;쇰&#65533; 罹&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;곕&#65533;쇱&#65533;&#65533;
    <code>fastdbd</code>媛&#65533; &#65533;&#65533; &#65533;⑥&#65533;⑥&#65533;&#65533;&#65533;닿&#65533; 鍮&#65533;瑜댁&#65533;留&#65533;,
    &#65533;&#65533;踰&#65533;媛&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;源&#65533;吏&#65533; &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;&#65533; 蹂&#65533;寃&#65533; &#65533;ы&#65533;&#65533;&#65533;&#65533;
    諛&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>荑쇰━媛&#65533; &#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;硫&#65533; 寃곌낵 &#65533;명&#65533;몄&#65533;&#65533;&#65533;&#65533;
    臾댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <div class="example"><h3>&#65533;&#65533;&#65533;&#65533;</h3><pre class="prettyprint lang-config">RewriteMap myquery "fastdbd:SELECT destination FROM rewrite WHERE source = %s"</pre>
</div>

    <div class="note"><h3>李멸&#65533;</h3>
    <p>荑쇰━ &#65533;대&#65533;&#65533;&#65533; SQL 以&#65533;鍮&#65533;&#65533;&#65533; 臾몄&#65533;&#65533; &#65533;&#65533;&#65533;대&#65533;濡&#65533; &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;&#65533;
    &#65533;&#65533;&#65533;쇱&#65533;대&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;щ&#65533;&#65533;誘&#65533;濡&#65533; &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533;
    洹&#65533;移&#65533;(&#65533;&#65533;&#65533;&#65533;臾몄&#65533;&#65533; 援щ&#65533; &#65533;&#65533;)&#65533;&#65533; &#65533;곕&#65533;쇱&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p></div>

  </div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="summary" id="summary">&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#summary" class="permalink">&para;</a></h2>
    

    <p><code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
    &#65533;щ&#65533;&#65533; 踰&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. 媛&#65533; 留ㅽ&#65533;&#65533; &#65533;⑥&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
    &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;(<code>.htaccess</code> &#65533;&#65533;&#65533;쇱&#65533;대&#65533;&#65533;
    <code class="directive"><a href="../mod/core.html#directory">&lt;Directory&gt;</a></code>
    釉&#65533;濡&#65533;)&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 留듭&#65533;&#65533; <strong>&#65533;&#65533;&#65533;&#65533;</strong>&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;吏&#65533;留&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 留듭&#65533;&#65533; <strong>&#65533;ъ&#65533;&#65533;</strong>&#65533;&#65533;&#65533;&#65533;
    寃&#65533;&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

  </div></div>
