<div class="outofdate">이 문서는 최신판 번역이 아닙니다.
            최근에 변경된 내용은 영어 문서를 참고하세요.</div>


    <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; <a href="intro.html#regex">&#65533;&#65533;洹&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;</a> 洹&#65533;移&#65533;&#65533;&#65533; 湲곕&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;댁&#65533;ㅻ&#65533;&#65533; URL &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;&#65533;怨듯&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533;
    &#65533;대&#65533; URL 援ъ&ldquo;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;쇰&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

      <p>&#65533;닿&#65533;&#65533;&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;怨&#65533; 媛&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
      泥⑤&#65533;&#65533;&#65533; 洹&#65533;移&#65533; 議곌굔&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;留&#65533;濡&#65533; &#65533;&#65533;&#65533;고&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;ν&#65533;&#65533;
      URL 議곗&#65533;&#65533; 硫&#65533;而ㅻ&#65533;&#65533;利&#65533;&#65533;&#65533; &#65533;&#65533;怨듯&#65533;⑸&#65533;&#65533;&#65533;&#65533;. URL 議곗&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533; &#65533;&#65533;議댄&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;: &#65533;&#65533;踰&#65533; 蹂&#65533;&#65533;&#65533;, &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;,
      HTTP &#65533;ㅻ&#65533;&#65533;, &#65533;&#65533;&#65533;&#65533;&#65533;ㅽ&#65533;ы&#65533;&#65533;, &#65533;몃&#65533; &#65533;곗&#65533;댄&#65533;곕&#65533;&#65533;댁&#65533;&#65533; 議고&#65533;&#65533; 諛&#65533;
      &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 湲고&#65533;&#65533; &#65533;몃&#65533; &#65533;&#65533;濡&#65533;洹몃&#65533;⑥&#65533;대&#65533;&#65533; &#65533;몃&#65533;ㅻ&#65533;щ&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;
      &#65533;몃&#65533;&#65533;&#65533; URL 留ㅼ묶&#65533;&#65533; &#65533;ъ&#65533;깊&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

      <p>&#65533;ъ&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 寃쎈&#65533; &#65533;&#65533;蹂&#65533; 諛&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;&#65533; 遺&#65533;遺&#65533;&#65533;&#65533;
      &#65533;ы&#65533;⑦&#65533;&#65533; &#65533;&#65533;泥&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, &#65533;&#65533;踰&#65533;蹂&#65533;
      而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;(<code>httpd.conf</code>), 媛&#65533;&#65533;&#65533;&#65533;몄&#65533;ㅽ&#65533;몃&#65533;
      而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;(<code class="directive"><a href="../mod/core.html#virtualhost">&lt;VirtualHost&gt;</a></code> 釉&#65533;濡&#65533;) &#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;(<code>.htaccess</code> &#65533;&#65533;&#65533;&#65533; 諛&#65533;
      <code class="directive"><a href="../mod/core.html#directory">&lt;Directory&gt;</a></code> 釉&#65533;濡&#65533;)&#65533;&#65533;&#65533;&#65533;
      &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;ъ&#65533;&#65533;&#65533;깅&#65533;&#65533; 寃곌낵&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 泥⑤&#65533;&#65533;&#65533;&#65533;&#65533;
      <a href="flags.html">&#65533;&#65533;&#65533;&#65533;洹&#65533;</a>&#65533;&#65533; &#65533;곕&#65533;&#65533; 異&#65533;媛&#65533; 洹&#65533;移&#65533;,
      &#65533;대&#65533; &#65533;&#65533;&#65533;&#65533; 泥&#65533;由&#65533;, &#65533;몃&#65533; &#65533;&#65533;泥&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;
      &#65533;⑥&#65533;ㅼ&#65533;ㅻ（濡&#65533; &#65533;댁&#65533;댁&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

      <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; 留ㅼ&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533;誘&#65533;濡&#65533;
      &#65533;&#65533;&#65533;뱁&#65533;&#65533; 蹂듭&#65533;≫&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533;
      <a href="../mod/mod_rewrite.html">李몄&ldquo; 臾몄&#65533;&#65533;</a>瑜&#65533;
      蹂댁땐&#65533;&#65533;硫&#65533;, &#65533;대&#65533;ы&#65533;&#65533; 蹂듭&#65533;≪&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533;
      <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>濡&#65533; 泥&#65533;由ы&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;쇰&#65533;&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;由ъ&#65533;ㅼ&#65533;&#65533; 二쇱&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;遺&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;怨듯&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.
      &#65533;&#65533;吏&#65533;留&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533; 蹂댁&#65533;ъ＜硫&#65533;, &#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ &#65533;&#65533;以&#65533; Apache 湲곕&#65533;μ&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;
      &#65533;대&#65533;ы&#65533;&#65533; 遺&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 蹂듭&#65533;≪&#65533;깆&#65533;&#65533; &#65533;쇳&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>


<ul>
<li><a href="../mod/mod_rewrite.html">mod_rewrite 李몄&ldquo;
臾몄&#65533;&#65533;</a></li>
<li><a href="intro.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; mod_rewrite &#65533;&#65533;媛&#65533;</a></li>
<li><a href="flags.html">RewriteRule &#65533;&#65533;&#65533;&#65533;洹&#65533;</a></li>
<li><a href="rewritemap.html">RewriteMap &#65533;ъ&#65533;⑺&#65533;&#65533;湲&#65533;</a></li>
<li><a href="avoid.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; <strong>留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;</strong> 寃쎌&#65533;&#65533;</a></li>
<li><a href="remapping.html">URL 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533; 諛&#65533; &#65533;щℓ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; mod_rewrite &#65533;ъ&#65533;&#65533;</a></li>
<li><a href="access.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; mod_rewrite &#65533;ъ&#65533;&#65533;</a></li>
<li><a href="vhosts.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li>
<li><a href="proxy.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;</a></li>
<li><a href="advanced.html">怨&#65533;湲&#65533; 湲곗&#65533;&#65533;</a></li>
<li><a href="tech.html">湲곗&#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533; &#65533;ы&#65533;&#65533;</a></li>
</ul>
</div>
