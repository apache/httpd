<div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="introduction" id="introduction">&#65533;&#65533;媛&#65533;</a> <a title="Permanent link" href="#introduction" class="permalink">&para;</a></h2>
<p><code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
洹&#65533;移&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;愿&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;硫&#65533;, &#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;쇳&#65533;&#65533;濡&#65533;
援щ&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
<pre class="prettyprint lang-config">RewriteRule pattern target [Flag1,Flag2,Flag3]</pre>


<p>媛&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; (紐&#65533; 媛&#65533;吏&#65533; &#65533;&#65533;&#65533;몃&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;) <code>CO</code>&#65533;&#65533;
媛&#65533;&#65533;&#65533; 吏㏃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code>cookie</code>&#65533;&#65533; 媛&#65533;&#65533;&#65533; 湲&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533;
媛&#65533;吏&#65533;&#65533;&#65533;&#65533;&#65533;. 吏㏃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;쇰&#65533;&#65533;&#65533;&#65533;댁&#65533;留&#65533;,
媛&#65533; &#65533;&#65533;&#65533;&#65533;洹멸&#65533; 臾댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;吏&#65533; 湲곗&#65533;듯&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; 湲&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;듭&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 醫&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;쇰&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533;
&#65533;몄&#65533;&#65533;瑜&#65533; 痍⑦&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;臾몄&#65533;&#65533;瑜&#65533; 援щ&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;泥&#65533;怨&#65533; 愿&#65533;&#65533;⑤&#65533;&#65533; 硫&#65533;&#65533;&#65533;&#65533;곗&#65533;댄&#65533;곕&#65533;&#65533; 蹂&#65533;寃쏀&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹&#65533;(T=, H=, E=)&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 諛&#65533; htaccess 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 泥&#65533;由&#65533;
&#65533;쇱&#65533;대&#65533;&#65533; 以&#65533;&#65533;&#65533; ('-' &#65533;댁&#65533;몄&#65533;&#65533;) 移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;④낵媛&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
</p>

<p>&#65533;ш린&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533; 媛&#65533; &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; &#65533;④&#65533; &#65533;ъ&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_b" id="flag_b">B (&#65533;&#65533;李몄“ &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;)</a> <a title="Permanent link" href="#flag_b" class="permalink">&para;</a></h2>
<p>[B] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;レ&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;瑜&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533;
吏&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; URL&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;瑜&#65533; &#65533;댁&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533;誘&#65533;濡&#65533;, &#65533;&#65533;李몄“&#65533;&#65533; &#65533;&#65533;&#65533;⑸&#65533;&#65533; &#65533;&#65533;
&#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;媛&#65533; &#65533;댁&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. B &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533;李몄“&#65533;&#65533;
&#65533;&#65533;&#65533;レ&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;:</p>

<p>&#65533;&#65533;踰&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;
    "escape" <a href="#mapfunc">留ㅽ&#65533;&#65533; &#65533;⑥&#65533;&#65533;</a>瑜&#65533; 李몄“&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;</p>


<pre class="prettyprint lang-config">RewriteRule "^search/(.*)$" "/search.php?term=$1"</pre>


<p>寃&#65533;&#65533;&#65533;&#65533;닿&#65533; 'x &amp; y/z'&#65533;&#65533; 寃쎌&#65533;&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;
'x%20%26%20y%2Fz'濡&#65533; &#65533;몄&#65533;&#65533;⑺&#65533;&#65533;&#65533;&#65533; 'search/x%20%26%20y%2Fz'
&#65533;&#65533;泥&#65533;&#65533;&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. B &#65533;&#65533;&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533;
'search.php?term=x &amp; y/z'濡&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;硫&#65533;, &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;⑦&#65533;&#65533;
URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;誘&#65533;濡&#65533; <code>search.php?term=x%20&amp;y%2Fz=</code>濡&#65533;
&#65533;몄&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;怨&#65533; &#65533;ㅻ&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;&#65533;쇳&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; B &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; 留ㅺ&#65533;蹂&#65533;&#65533;&#65533;媛&#65533; 異&#65533;&#65533;&#65533; URL&#65533;&#65533;
&#65533;&#65533;&#65533;щ&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;
<code>/search.php?term=x%20%26%20y%2Fz</code>濡&#65533; &#65533;щ&#65533;瑜닿&#65533;
留ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteRule "^search/(.*)$" "/search.php?term=$1" [B,PT]</pre>


<p>&#65533;&#65533; &#65533;뱀&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃
<code class="directive"><a href="../mod/core.html#allowencodedslashes">AllowEncodedSlashes</a></code>瑜&#65533;
<code>On</code>&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. httpd&#65533;&#65533;
URL&#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;&#65533; &#65533;щ&#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;⑺&#65533;&#65533;吏&#65533; &#65533;&#65533;怨&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 蹂대㈃
404瑜&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;湲&#65533; &#65533;&#65533;臾몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533; &#65533;뱁&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;⑹&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
諛깆&#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;諛&#65533;&#65533;쇰㈃ 以&#65533;&#65533;⑤&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;湲&#65533; &#65533;&#65533;臾몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; %{THE_REQUEST}&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
罹≪&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;대ŉ, &#65533;대&#65533;&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533;
罹≪&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>2.4.26 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;李몄“&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533; 臾몄&#65533;&#65533;瑜&#65533;
&#65533;&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;: <code>[B=#?;]</code>.
李멸&#65533;: &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533; 紐⑸&#65533;&#65533;&#65533; 怨듬갚 臾몄&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;吏&#65533;留&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;&#65533;泥&#65533; &#65533;&#65533; 踰&#65533;吏&#65533; &#65533;몄&#65533;&#65533;瑜&#65533; &#65533;몄&#65533;⑺&#65533;댁&#65533;&#65533; &#65533;&#65533;硫&#65533; 怨듬갚&#65533;&#65533; 紐⑸&#65533;&#65533;&#65533; 留&#65533;吏&#65533;留&#65533;
臾몄&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config"># 怨듬갚怨&#65533; 臾쇱&#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 怨듬갚&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; 寃쎌&#65533;&#65533;
# 理&#65533;醫&#65533; &#65533;몄&#65533;&#65533; 二쇱&#65533;&#65533;&#65533;&#65533; &#65533;곗&#65533;댄&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
RewriteRule "^search/(.*)$" "/search.php?term=$1" "[B= ?]"</pre>


<p>&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;쇰&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃
<a href="#flag_bne">#flag_bne</a>&#65533;&#65533;
<a href="#flag_bctls">#flag_bctls</a>瑜&#65533; 李몄“&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_bnp" id="flag_bnp">BNP|backrefnoplus (怨듬갚&#65533;&#65533; +濡&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;)</a> <a title="Permanent link" href="#flag_bnp" class="permalink">&para;</a></h2>
<p>[BNP] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;&#65533;李몄“&#65533;&#65533;&#65533;&#65533; 怨듬갚 臾몄&#65533;&#65533;瑜&#65533; '+' &#65533;&#65533;&#65533;&#65533; %20&#65533;쇰&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533;
吏&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;李몄“媛&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎈&#65533; 援ъ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;⑸&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config"># 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;異&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533; + &#65533;&#65533;&#65533;&#65533;
# 寃쎈&#65533;&#65533;&#65533;&#65533;&#65533; 怨듬갚&#65533;&#65533; %20&#65533;쇰&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;
RewriteRule "^search/(.*)$" "/search.php/$1" "[B,BNP]"</pre>



<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 踰&#65533;&#65533;&#65533; 2.4.26 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_bctls" id="flag_bctls">BCTLS</a> <a title="Permanent link" href="#flag_bctls" class="permalink">&para;</a></h2>
<p>[BCTLS] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; [B] &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;吏&#65533;留&#65533; &#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533;
怨듬갚 臾몄&#65533;&#65533;留&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 梨&#65533;
荑쇰━ 臾몄&#65533;&#65533;&#65533;대&#65533; 蹂듭&#65533;щ&#65533;&#65533; &#65533;&#65533; 嫄곕&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; 臾몄&#65533;&#65533; &#65533;명&#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
</p>

<pre class="prettyprint lang-config"># &#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; 怨듬갚&#65533;&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;
RewriteRule "^search/(.*)$" "/search.php/$1" "[BCTLS]"</pre>


<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 踰&#65533;&#65533;&#65533; 2.5.1 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_bne" id="flag_bne">BNE</a> <a title="Permanent link" href="#flag_bne" class="permalink">&para;</a></h2>
<p>[BNE=...]&#65533;&#65533; 臾몄&#65533;&#65533; 紐⑸&#65533;&#65533;&#65533; [B] &#65533;&#65533;&#65533;&#65533; [BCTLS] &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533;
臾몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;몃&#65533; 泥&#65533;由щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;대&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
</p>

<pre class="prettyprint lang-config"># 湲곕낯 臾몄&#65533;&#65533;瑜&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; /&#65533;&#65533; &#65533;④&#65533;
RewriteRule "^search/(.*)$" "/search.php?term=$1" "[B,BNE=/]"</pre>


<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 踰&#65533;&#65533;&#65533; 2.5.1 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_c" id="flag_c">C|chain</a> <a title="Permanent link" href="#flag_c" class="permalink">&para;</a></h2>
<p>[C] &#65533;&#65533;&#65533;&#65533; [chain] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533;
泥댁&#65533;몃&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. 利&#65533;, 洹&#65533;移&#65533;&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533;硫&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
媛&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;怨&#65533; &#65533;&#65533;&#65533;닿&#65533; &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;쇰&#65533; &#65533;대&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;щ&#65533;&#65533;
&#65533;쇱&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;怨&#65533; &#65533;④&#65533; 泥댁&#65533;몃&#65533;&#65533; &#65533;ㅻⅨ 紐⑤&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533;
嫄대&#65533;&#65533;&#65533;곗&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_co" id="flag_co">CO|cookie</a> <a title="Permanent link" href="#flag_co" class="permalink">&para;</a></h2>
<p>[CO] &#65533;&#65533;&#65533;&#65533; [cookie] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;뱀&#65533;&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;쇱&#65533;&#65533;&#65533; &#65533;&#65533; 荑&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 媛&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;濡&#65533; 援ъ&#65533;깅&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; &#65533;&#65533;泥&#65533; 援щЦ&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;ы&#65533;⑦&#65533;&#65533;&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<div class="example"><p><code>
[CO=NAME:VALUE:DOMAIN:lifetime:path:secure:httponly:samesite]
</code></p></div>

<p>荑&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 由ы&#65533;곕&#65533;&#65533; ':' 臾몄&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533;泥&#65533; 援щЦ&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;泥&#65533; 援щЦ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃ 荑&#65533;&#65533;&#65533; "Name" &#65533;&#65533;&#65533;&#65533;
';' 臾몄&#65533;&#65533;瑜&#65533; 遺&#65533;&#65533;닿&#65533; &#65533;&#65533;&#65533;&#65533; 援щ&#65533;&#65533;&#65533;瑜&#65533; ';'濡&#65533; 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<div class="example"><p><code>
[CO=;NAME;VALUE:MOREVALUE;DOMAIN;lifetime;path;secure;httponly;samesite]
</code></p></div>

<p>荑&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃ &#65533;대&#65533;, 媛&#65533; 諛&#65533; &#65533;&#65533;硫&#65533;&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;댁&#65533;&#65533;
&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<dl>
<dt>Domain</dt>
<dd>荑&#65533;&#65533;ㅺ&#65533; &#65533;&#65533;&#65533;⑦&#65533;&#65533; &#65533;&#65533;硫&#65533;&#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. <code>www.example.com</code>怨&#65533;
媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;닿굅&#65533;&#65533; <code>.example.com</code>怨&#65533; 媛&#65533;&#65533;&#65533;
&#65533;&#65533;硫&#65533;&#65533;몄&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;쇰&#65533; 援щ&#65533;&#65533;&#65533; 理&#65533;&#65533;&#65533; &#65533;&#65533; 遺&#65533;遺&#65533;&#65533;댁&#65533;댁&#65533;&#65533;
&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 利&#65533;, &#65533;⑥&#65533;&#65533;&#65533;&#65533; <code>.com</code>&#65533;대&#65533;&#65533;
<code>.net</code>&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;ы&#65533;&#65533; 醫&#65533;瑜&#65533;&#65533;&#65533; 荑&#65533;&#65533;ㅻ&#65533;&#65533;
荑&#65533;&#65533;&#65533; 蹂댁&#65533;&#65533; 紐⑤&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 湲&#65533;吏&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>
</dl>

<p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<dl>
<dt>Lifetime</dt>
<dd>荑&#65533;&#65533;ㅺ&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;媛&#65533;(遺&#65533;)&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</dd>
<dd>媛&#65533;&#65533;&#65533; 0&#65533;대㈃ 荑&#65533;&#65533;ㅺ&#65533; &#65533;&#65533;&#65533;&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533; &#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;留&#65533; 吏&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
吏&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ &#65533;닿&#65533;&#65533;&#65533; 湲곕낯媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</dd>
<dd>&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 荑&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>

<dt>Path</dt>
<dd>&#65533;&#65533;&#65533;&#65533; &#65533;뱀&#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533;&#65533;&#65533; 荑&#65533;&#65533;ㅺ&#65533; &#65533;&#65533;&#65533;⑦&#65533;&#65533; 寃쎈&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
&#65533;&#65533;: <code>/customers/</code> &#65533;&#65533;&#65533;&#65533;
<code>/files/download/</code>.</dd>
<dd>湲곕낯&#65533;&#65533;&#65533;쇰&#65533; <code>/</code>濡&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; - 利&#65533;,
&#65533;&#65533;泥&#65533; &#65533;뱀&#65533;ъ&#65533;댄&#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</dd>

<dt>Secure</dt>
<dd><code>secure</code>, <code>true</code> &#65533;&#65533;&#65533;&#65533;
<code>1</code>濡&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; 荑&#65533;&#65533;ㅻ&#65533;&#65533; 蹂댁&#65533;&#65533;(https) &#65533;곌껐&#65533;&#65533;
&#65533;듯&#65533;댁&#65533;&#65533;留&#65533; &#65533;&#65533;&#65533;щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>

<dt>httponly</dt>
<dd><code>HttpOnly</code>, <code>true</code> &#65533;&#65533;&#65533;&#65533;
<code>1</code>濡&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; 荑&#65533;&#65533;ㅼ&#65533;&#65533;
<code>HttpOnly</code> &#65533;&#65533;&#65533;&#65533;洹멸&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533;, &#65533;대&#65533;&#65533; &#65533;&#65533; 湲곕&#65533;μ&#65533;&#65533;
吏&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 荑&#65533;&#65533;ㅺ&#65533; JavaScript 肄&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;洹쇳&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;誘명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>

<dt>samesite</dt>
<dd><code>false</code> &#65533;&#65533;&#65533;&#65533; <code>0</code> &#65533;댁&#65533;몄&#65533;&#65533; 媛&#65533;&#65533;쇰&#65533;
&#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; <code>SameSite</code> &#65533;&#65533;&#65533;깆&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;쇰&#65533;
&#65533;ㅼ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;쇰&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; <code>None</code>,
<code>Lax</code> 諛&#65533; <code>Strict</code>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
2.5.1 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</dd>
</dl>


<p>&#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine On
RewriteRule   "^/index\.html"   "-" [CO=frontdoor:yes:.example.com:1440:/]</pre>


<p>二쇱&#65533;댁&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
"-" &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533;寃&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
蹂&#65533;寃&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;듦낵&#65533;&#65533;&#65533;ㅻ&#65533;&#65533;濡&#65533; 吏&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533; 'frontdoor'&#65533;쇰&#65533;&#65533;
荑&#65533;&#65533;ㅻ&#65533;&#65533; 'yes' 媛&#65533;&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 荑&#65533;&#65533;ㅻ&#65533;&#65533;
<code>.example.com</code> &#65533;&#65533;硫&#65533;&#65533;몄&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;⑦&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
1440遺&#65533;(24&#65533;&#65533;媛&#65533;) &#65533;&#65533;&#65533;&#65533; 留&#65533;猷&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; 紐⑤&#65533;&#65533; URI&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_dpi" id="flag_dpi">DPI|discardpath</a> <a title="Permanent link" href="#flag_dpi" class="permalink">&para;</a></h2>
<p>DPI &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깅&#65533;&#65533; URI&#65533;&#65533; PATH_INFO 遺&#65533;遺&#65533;&#65533;&#65533;
踰&#65533;由쎈&#65533;&#65533;&#65533;&#65533;.</p>
<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 踰&#65533;&#65533;&#65533; 2.2.12 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
<p>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; 媛&#65533;
<code class="directive">RewriteRule</code>&#65533;&#65533; 鍮&#65533;援&#65533;&#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533; URI&#65533;&#65533;
PATH_INFO&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;곌껐&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;멸&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 珥&#65533;湲&#65533; URI&#65533;닿굅&#65533;&#65533;,
&#65533;댁&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533;&#65533;&#65533; 寃곌낵&#65533;닿굅&#65533;&#65533;,
&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533;
洹&#65533;移&#65533;&#65533;&#65533; 寃곌낵&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>諛&#65533;硫&#65533;, 媛&#65533; 洹&#65533;移&#65533; &#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533; 異&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; PATH_INFO&#65533;&#65533;
&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; PATH_INFO
媛&#65533;留&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 寃곌낵&#65533;&#65533;&#65533;쇰&#65533; URI&#65533;&#65533; &#65533;&#65533; 遺&#65533;遺&#65533;&#65533;&#65533; &#65533;щ&#65533;&#65533;
<code class="directive">RewriteRule</code> 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;쇰&#65533;
&#65533;쇱&#65533;&#65533;&#65533;怨&#65533; 蹂듭&#65533;щ&#65533;&#65533; &#65533;&#65533;, URI&#65533;&#65533; &#65533;대&#65533;&#65533; 遺&#65533;遺&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; PATH_INFO&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;吏&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ 理&#65533;醫&#65533; URI&#65533;&#65533; PATH_INFO&#65533;&#65533; &#65533;щ&#65533;&#65533; 蹂듭&#65533;щ낯&#65533;&#65533;
異&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;댁&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;깅&#65533;&#65533; PATH_INFO媛&#65533;
愿&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;
PATH_INFO瑜&#65533; &#65533;&#65533;援ъ&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. PATH_INFO&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533;媛&#65533; &#65533;&#65533;猷&#65533;&#65533;&#65533; &#65533;&#65533;源&#65533;吏&#65533;
&#65533;ㅼ&#65533;&#65533; 怨&#65533;&#65533;곕&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533;
PATH_INFO媛&#65533; 異&#65533;媛&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃곌낵留&#65533; 遊&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_e" id="flag_e">E|env</a> <a title="Permanent link" href="#flag_e" class="permalink">&para;</a></h2>
<p>[E] &#65533;&#65533;&#65533;&#65533; [env] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;쇰&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533;, &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533; &#65533;댁&#65533;⑹&#65533;&#65533;
<a href="../env.html">&#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;</a>瑜&#65533; 李몄“&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; &#65533;&#65533;泥&#65533; 援щЦ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">[E=VAR:VAL]
[E=!VAR]</pre>


<p><code>VAL</code>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;λ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;李몄“(<code>$N</code>
&#65533;&#65533;&#65533;&#65533; <code>%N</code>)媛&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>吏㏃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;</p>

<div class="example"><p><code>
[E=VAR]
</code></p></div>

<p><code>VAR</code>&#65533;대&#65533;쇰&#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; 鍮&#65533; 媛&#65533;&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;</p>

<div class="example"><p><code>
[E=!VAR]
</code></p></div>

<p>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; <code>VAR</code>&#65533;대&#65533;쇰&#65533;&#65533;
&#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; CGI &#65533;&#65533;濡&#65533;洹몃&#65533;&#65533;, &#65533;ㅻⅨ RewriteRule 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
CustomLog 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ы&#65533;⑦&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; URI媛&#65533; &#65533;대&#65533;몄&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; 寃쎌&#65533;&#65533;
'image'&#65533;쇰&#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; '1' 媛&#65533;&#65533;쇰&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;
&#65533;대&#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;洹&#65533; 濡&#65533;洹몄&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteRule "\.(png|gif|jpg)$"   "-" [E=image:1]
CustomLog   "logs/access_log"    combined env=!image</pre>


<p>&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; &#65533;④낵&#65533;&#65533; <code class="directive"><a href="../mod/mod_setenvif.html#setenvif">SetEnvIf</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;살&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 湲곗&#65533;&#65533;&#65533;&#65533; 沅&#65533;&#65533;&#65533; &#65533;ы&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;怨듬&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_end" id="flag_end">END</a> <a title="Permanent link" href="#flag_end" class="permalink">&para;</a></h2>
<p>[END] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; ([L]怨&#65533; 媛&#65533;&#65533;&#65533;) &#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 泥&#65533;由&#65533;
&#65533;쇱&#65533;대&#65533;&#65533;瑜&#65533; 醫&#65533;猷&#65533;&#65533;&#65533; 肉&#65533;留&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533;(htaccess)
而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 泥&#65533;由ш&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;
諛⑹&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;닿&#65533;&#65533;&#65533; &#65533;몃&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533; &#65533;명&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;⑸&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_f" id="flag_f">F|forbidden</a> <a title="Permanent link" href="#flag_f" class="permalink">&para;</a></h2>
<p>[F] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533;踰&#65533;媛&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몄&#65533;&#65533; 403 Forbidden
&#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;瑜&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. <code class="directive"><a href="../mod/mod_access_compat.html#deny">Deny</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;吏&#65533;留&#65533;, &#65533;닿&#65533;&#65533;&#65533; Forbidden
&#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;뱁&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533; 留&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;곗&#65533;깆&#65533;&#65533; &#65533;&#65533;怨듯&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533;&#65533;&#65533; <code>.exe</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533;
&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;瑜&#65533; 湲&#65533;吏&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteRule "\.exe"   "-" [F]</pre>


<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; "-" 援щЦ&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;, &#65533;&#65533;泥&#65533;&#65533;&#65533;
URI媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;誘명&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;泥&#65533;&#65533;&#65533; 湲&#65533;吏&#65533;&#65533;&#65533;&#65533;ㅻ&#65533;&#65533; 寃쎌&#65533;&#65533;
&#65533;ㅻⅨ URI濡&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533; &#65533;댁&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>[F]瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; [L]&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; - 利&#65533;, &#65533;&#65533;&#65533;듭&#65533;&#65533; 利&#65533;&#65533;&#65533;
諛&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; 異&#65533;媛&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_g" id="flag_g">G|gone</a> <a title="Permanent link" href="#flag_g" class="permalink">&para;</a></h2>
<p>[G] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533;踰&#65533;媛&#65533; &#65533;&#65533;&#65533;듦낵 &#65533;④&#65533; 410 Gone &#65533;&#65533;&#65533;&#65533;瑜&#65533;
諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;
媛&#65533;&#65533;ν&#65533;&#65533;吏&#65533;留&#65533; &#65533;&#65533; &#65533;댁&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>[F] &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; 留&#65533;李ш&#65533;吏&#65533;濡&#65533; [G] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;쇰&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; "-" 援щЦ&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "oldproduct"   "-" [G,NC]</pre>


<p>[G]瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; [L]&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; - 利&#65533;, &#65533;&#65533;&#65533;듭&#65533;&#65533; 利&#65533;&#65533;&#65533;
諛&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; 異&#65533;媛&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_h" id="flag_h">H|handler</a> <a title="Permanent link" href="#flag_h" class="permalink">&para;</a></h2>
<p>寃곌낵 &#65533;&#65533;泥&#65533;&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533;ㅻ&#65533;щ&#65533; 泥&#65533;由щ&#65533;&#65533;&#65533;&#65533;濡&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; php &#65533;몃&#65533;ㅻ&#65533;щ&#65533;
&#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533;濡&#65533; 媛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "!\."  "-" [H=application/x-httpd-php]</pre>


<p>
&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; - <code>!\.</code> - &#65533;&#65533; 由ы&#65533;곕&#65533;&#65533; <code>.</code>
臾몄&#65533;&#65533;瑜&#65533; &#65533;ы&#65533;⑦&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;泥&#65533;怨&#65533; &#65533;쇱&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<p>&#65533;닿&#65533;&#65533;&#65533; &#65533;쇰&#65533; 議곌굔&#65533;&#65533; &#65533;곕&#65533;&#65533; &#65533;몃&#65533;ㅻ&#65533;щ&#65533;&#65533; 媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;곗&#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;&#65533;踰&#65533;蹂&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;&#65533;レ&#65533;&#65533; <code>.phps</code> &#65533;&#65533;&#65533;μ&#65533;&#65533;濡&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;
<code>.php</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533; <code>mod_php</code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
<em>&#65533;&#65533;&#65533;&#65533;</em>&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "^(/source/.+\.php)s$" "$1" [H=application/x-httpd-php-source]</pre>


<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; - <code>^(/source/.+\.php)s$</code> -
&#65533;&#65533; <code>/source/</code>濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; 1媛&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;ㅻ&#65533;곕Ⅴ怨&#65533;
由ы&#65533;곕&#65533;&#65533; <code>.phps</code>媛&#65533; &#65533;ㅻ&#65533;곕Ⅴ&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;泥&#65533;怨&#65533; &#65533;쇱&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
&#65533;&#65533;李몄“ $1&#65533;&#65533; &#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 愿&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 罹≪&#65533;&#65533;&#65533; &#65533;쇱&#65533;瑜&#65533;
李몄“&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_l" id="flag_l">L|last</a> <a title="Permanent link" href="#flag_l" class="permalink">&para;</a></h2>
<p>[L] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>媛&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몄&#65533;&#65533;
泥&#65533;由щ&#65533;&#65533; 以&#65533;吏&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;遺&#65533;遺&#65533;&#65533;&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;닿&#65533;&#65533;&#65533;
洹&#65533;移&#65533;&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533;硫&#65533; &#65533;&#65533; &#65533;댁&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;誘명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
&#65533;닿&#65533;&#65533;&#65533; Perl&#65533;&#65533; <code>last</code> 紐&#65533;&#65533;뱀&#65533;대&#65533;&#65533; C&#65533;&#65533;
<code>break</code> 紐&#65533;&#65533;뱀&#65533;&#65533; &#65533;대&#65533;뱁&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 異&#65533;媛&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533;吏&#65533; &#65533;&#65533;怨&#65533; 利&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;댁&#65533;&#65533;
&#65533;⑥&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p><code>.htaccess</code> &#65533;&#65533;&#65533;쇱&#65533;대&#65533;&#65533;
<code class="directive"><a href="../mod/core.html#directory">&lt;Directory&gt;</a></code>
&#65533;뱀&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;댄&#65533;닿&#65533; 以&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
&#65533;닿&#65533;&#65533;&#65533; 媛&#65533;&#65533;⑦&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;硫&#65533; &#65533;ъ&#65533;&#65533;&#65533;깅&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
URL &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;吏&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;щ&#65533;&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;&#65533;ㅻ&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
&#65533;ъ&#65533;&#65533;&#65533;깅&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533; &#65533;&#65533; <code>.htaccess</code> &#65533;&#65533;&#65533;쇱&#65533;대&#65533;&#65533;
<code class="directive"><a href="../mod/core.html#directory">&lt;Directory&gt;</a></code>
&#65533;뱀&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 留&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, &#65533;곕&#65533;쇱&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;멸&#65533; 泥&#65533;&#65533;&#65533;遺&#65533;&#65533;&#65533;
&#65533;ㅼ&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. 媛&#65533;&#65533;&#65533; &#65533;쇰&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;닿&#65533;&#65533;&#65533; 洹&#65533;移&#65533; 以&#65533;
&#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;대&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;&#65533; &#65533;쇱&#65533;쇱&#65533; &#65533;&#65533;泥&#65533; 泥&#65533;由ш&#65533;
&#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;곗&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;곕&#65533;쇱&#65533;&#65533; &#65533;대&#65533;ы&#65533;&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 以&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 猷⑦&#65533;&#65533;&#65533;&#65533; &#65533;쇳&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; 紐&#65533;&#65533;&#65533;&#65533;&#65533; 議곗&#65533;瑜&#65533;
痍⑦&#65533;&#65533;怨&#65533;, &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533; &#65533;쇰&#65533;⑥&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533; 醫&#65533;猷&#65533;&#65533;&#65533;湲&#65533;
&#65533;&#65533;&#65533;&#65533; [L] &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533;留&#65533; &#65533;&#65533;議댄&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 以&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; [END]&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533;瑜&#65533;
醫&#65533;猷&#65533;&#65533;&#65533; 肉&#65533;留&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533;(htaccess) 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 泥&#65533;由ш&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 諛⑹&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533;
&#65533;몃&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533; &#65533;명&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;⑸&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;ш린 二쇱&#65533;댁&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; <code>index.php</code>濡&#65533;
&#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;硫&#65533;, &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; <code>index.php</code>&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;&#65533;
&#65533;몄&#65533;&#65533;濡&#65533; &#65533;&#65533;怨듯&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;щ&#65533;&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code>&#65533;&#65533;
&#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; <code>index.php</code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
嫄대&#65533;&#65533;&#65533;곗&#65533;댁&#65533;&#65533;&#65533;濡&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteBase "/"
RewriteCond "%{REQUEST_URI}" !=/index.php
RewriteRule "^(.*)"          "/index.php?req=$1" [L,PT]</pre>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_n" id="flag_n">N|next</a> <a title="Permanent link" href="#flag_n" class="permalink">&para;</a></h2>
<p>
[N] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; 吏&#65533;湲&#65533;源&#65533;吏&#65533;&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;&#65533; 寃곌낵瑜&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 泥&#65533;&#65533;&#65533;遺&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.
猷⑦&#65533;&#65533;瑜&#65533; 珥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533; 洹밸&#65533;&#65533;&#65533;&#65533; 二쇱&#65533;&#65533;瑜&#65533; 湲곗&#65533;몄&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
</p>
<p>
[Next] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;뱀&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;댁&#65533;대&#65533;&#65533;
臾몄&#65533;&#65533;瑜&#65533; 諛&#65533;蹂듭&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;泥댄&#65533;&#65533;&#65533;ㅻ&#65533;&#65533; 寃쎌&#65533;곗&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
&#65533;ш린 &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; 怨녹&#65533;&#65533;&#65533;&#65533; A瑜&#65533; B濡&#65533; &#65533;&#65533;泥댄&#65533;&#65533;硫&#65533;
&#65533;&#65533; &#65533;댁&#65533;&#65533; &#65533;&#65533;泥댄&#65533;&#65533; A媛&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;源&#65533;吏&#65533; 怨&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>
<pre class="prettyprint lang-config">RewriteRule "(.*)A(.*)" "$1B$2" [N]</pre>

<p>&#65533;닿&#65533;&#65533;&#65533; <code>while</code> 猷⑦&#65533;&#65533;濡&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:
&#65533;&#65533; &#65533;⑦&#65533;댁&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;(利&#65533;, URI&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;
<code>A</code>媛&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;) &#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;(利&#65533;, <code>A</code>瑜&#65533; <code>B</code>濡&#65533;
&#65533;&#65533;泥댄&#65533;⑸&#65533;&#65533;&#65533;&#65533;).</p>

<p>2.5.0 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 紐⑤&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 猷⑦&#65533;&#65533;&#65533;쇰&#65533;遺&#65533;&#65533;&#65533;
蹂댄&#65533;명&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; 10,000踰&#65533;&#65533;&#65533; 諛&#65533;蹂&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;瑜&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
N &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; 異&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 理&#65533;&#65533;&#65533; 諛&#65533;蹂&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
<pre class="prettyprint lang-config"># 猷⑦&#65533;&#65533;&#65533;&#65533; 媛&#65533; &#65533;⑥&#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 1媛&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;瑜&#65533; &#65533;&#65533;泥댄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
RewriteRule "(.+)[&gt;&lt;;]$" "$1" [N=32000]
# ... &#65533;&#65533;&#65533;&#65533; 10踰&#65533; 猷⑦&#65533;&#65533; &#65533;&#65533; &#65533;ш린
RewriteRule "(.+)[&gt;&lt;;]$" "$1" [N=10]</pre>


</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_nc" id="flag_nc">NC|nocase</a> <a title="Permanent link" href="#flag_nc" class="permalink">&para;</a></h2>
<p>[NC] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;臾몄&#65533;&#65533;瑜&#65533; 援щ&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;쇰&#65533; &#65533;쇱&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 利&#65533;,
&#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;&#65533;臾몄&#65533;&#65533;&#65533;몄&#65533; &#65533;&#65533;臾몄&#65533;&#65533;&#65533;몄&#65533; &#65533;&#65533;愿&#65533;&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;몄&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;대&#65533;몄&#65533; &#65533;&#65533;踰&#65533;濡&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;쇱&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;臾몄&#65533;&#65533;瑜&#65533; 援щ&#65533;&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533;, &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; <code>.jpg</code>&#65533;&#65533; <code>.JPG</code>
&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteRule "(.*\.(jpg|gif|png))$" "http://images.example.com$1" [P,NC]</pre>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_ne" id="flag_ne">NE|noescape</a> <a title="Permanent link" href="#flag_ne" class="permalink">&para;</a></h2>
<p>湲곕낯&#65533;&#65533;&#65533;쇰&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;몃&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533; &#65533;댁&#65533;댁&#65533; &#65533;&#65533;, 異&#65533;&#65533;μ&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;몄&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; 16吏&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;(&#65533;쇱&#65533;쇳&#65533;&#65533; &#65533;몄&#65533;&#65533;&#65533;)濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<ul>
  <li>&#65533;&#65533;&#65533;レ&#65533;&#65533; 臾몄&#65533;&#65533;: <code>A-Z</code>, <code>a-z</code>,
  <code>0-9</code></li>
  <li>&#65533;뱀&#65533;&#65533; 臾몄&#65533;&#65533;: <code>$-_.+!*'(),:;@&amp;=/~</code></li>
</ul>

<p>&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, <code>#</code>&#65533;&#65533; <code>%23</code>&#65533;쇰&#65533;,
<code>?</code>&#65533;&#65533; <code>%3F</code>濡&#65533; 蹂&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
<code>%</code> 臾몄&#65533;&#65533;&#65533;&#65533; (<code>%25</code>濡&#65533;) &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;誘&#65533;濡&#65533;
移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; 議댁&#65533;ы&#65533;&#65533;&#65533;&#65533; &#65533;쇱&#65533;쇳&#65533;&#65533; &#65533;몄&#65533;&#65533;⑹&#65533;&#65533; &#65533;댁&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>[NE] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;瑜&#65533; 諛⑹&#65533;&#65533;&#65533;&#65533;&#65533;
<code>#</code>怨&#65533; <code>?</code>&#65533;&#65533; 媛&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;怨&#65533;
由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533; URL濡&#65533; &#65533;&#65533;&#65533;щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteRule "^/anchor/(.+)" "/bigpage.html#$1" [NE,R]</pre>


<p>
&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code>/anchor/xyz</code>瑜&#65533;
<code>/bigpage.html#xyz</code>濡&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
[NE]瑜&#65533; &#65533;&#65533;&#65533;듯&#65533;&#65533;硫&#65533; #&#65533;&#65533; 16吏&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;&#65533;&#65533; <code>%23</code>&#65533;쇰&#65533;
蹂&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 404 Not Found &#65533;ㅻ&#65533; 議곌굔&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_ns" id="flag_ns">NS|nosubreq</a> <a title="Permanent link" href="#flag_ns" class="permalink">&para;</a></h2>
<p>[NS] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;
諛⑹&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, SSI(Server Side Include)瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;
&#65533;ы&#65533;⑤&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;대ŉ, &#65533;대&#65533;&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533;
諛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;쇳&#65533;&#65533;怨&#65533; &#65533;띠&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_dir.html">mod_dir</a></code>&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533; 湲곕낯 &#65533;&#65533;&#65533;&#65533;(&#65533;&#65533;:
<code>index.html</code> &#65533;&#65533;&#65533;&#65533;)&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;蹂대&#65533;&#65533; 李얠&#65533;쇰&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;
&#65533;닿&#65533;&#65533;&#65533; &#65533;대&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;대ŉ, 醫&#65533;醫&#65533; &#65533;대&#65533;ы&#65533;&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;쇳&#65533;&#65533;怨&#65533; &#65533;띠&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;
洹&#65533;移&#65533; &#65533;명&#65533;멸&#65533; &#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰ŉ &#65533;ㅻ&#65533;瑜&#65533;
&#65533;쇱&#65533;쇳&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533;
洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; &#65533;щ&#65533;瑜&#65533; 寃곗&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃: CGI &#65533;ㅽ&#65533;щ┰&#65533;몃&#65533;
URL&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;щ&#65533;&#65533; 遺&#65533;&#65533;&#65533; CGI &#65533;ㅽ&#65533;щ┰&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;&#65533;&#65533;濡&#65533; 媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
寃쎌&#65533;&#65533;, &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;(&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;뱁&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;ㅻ&#65533;&#65533;)媛&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533;
媛&#65533;&#65533;μ&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;ы&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>
HTML &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533; &#65533;쇰&#65533;濡&#65533; 濡&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;몄&#65533;, &#65533;&#65533;諛&#65533;&#65533;ㅽ&#65533;щ┰&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; CSS &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; - 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;
蹂&#65533;&#65533;&#65533;&#65533;&#65533; HTTP &#65533;&#65533;泥&#65533;&#65533;쇰&#65533; &#65533;&#65533;泥&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_p" id="flag_p">P|proxy</a> <a title="Permanent link" href="#flag_p" class="permalink">&para;</a></h2>
<p>[P] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_proxy.html">mod_proxy</a></code>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;怨&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
&#65533;듯&#65533;&#65533; 泥&#65533;由щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, 紐⑤&#65533;&#65533; &#65533;대&#65533;몄&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 諛깆&#65533;&#65533;&#65533;&#65533;
&#65533;대&#65533;몄&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 泥&#65533;由щ&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;ㅻ㈃ &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "/(.*)\.(jpg|gif|png)$" "http://images.example.com/$1.$2" [P]</pre>


<p>[P] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; [L]&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; - 利&#65533;, &#65533;&#65533;泥&#65533;&#65533;&#65533;
利&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;瑜&#65533; &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;щ&#65533;&#65533;怨&#65533; &#65533;댄&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅻ&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>
移&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; <code class="module"><a href="../mod/mod_proxy.html">mod_proxy</a></code>媛&#65533; 泥&#65533;由ы&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;⑦&#65533;&#65533; URI(&#65533;쇰&#65533;&#65533;&#65533;&#65533;쇰&#65533; <code>http://</code><em>hostname</em>&#65533;쇰&#65533;
&#65533;&#65533;&#65533;&#65533;)&#65533;몄&#65533; &#65533;&#65533;&#65533;명&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ &#65533;&#65533;濡&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;ㅻ&#65533;媛&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 濡&#65533;而&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;댁&#65533;ㅼ&#65533;&#65533;
&#65533;&#65533;寃&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/mod_proxy.html#proxypass">ProxyPass</a></code> 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;
&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533; 援ы&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<div class="warning">
<h3>蹂댁&#65533;&#65533; 寃쎄&#65533;</h3>
<p>洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533; 援ъ&#65533;깊&#65533;&#65533; &#65533;&#65533;, &#65533;&#65533;踰&#65533;媛&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
URL &#65533;명&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몄&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;쇰&#65533; &#65533;명&#65533;&#65533; 蹂댁&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533;
怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533; 二쇱&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. URL&#65533;&#65533; &#65533;ㅽ&#65533;ㅻ&#65533; 諛&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533; 遺&#65533;遺&#65533;&#65533;&#65533;
怨&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;嫄곕&#65533;&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몄&#65533;&#65533;寃&#65533; 遺&#65533;&#65533;뱁&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533; 二쇱&#65533;
&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
</div>

<div class="warning">
<h3>&#65533;깅&#65533;&#65533; 寃쎄&#65533;</h3>
<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; <code class="module"><a href="../mod/mod_proxy.html">mod_proxy</a></code>&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;
&#65533;몃━嫄곕&#65533;&#65533;硫&#65533;, &#65533;&#65533; 寃쎌&#65533;&#65533; 湲곕낯 &#65533;&#65533;而ㅺ&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533; &#65533;곌껐
&#65533;&#65533;留&#65533;/&#65533;ъ&#65533;ъ&#65533;⑹&#65533;&#65533; 泥&#65533;由ы&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰&#65533;&#65533;濡&#65533; &#65533;&#65533;援&#65533; &#65533;곌껐&#65533;&#65533; 泥&#65533;由ы&#65533;&#65533;吏&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
<p>&#65533;&#65533;援&#65533; &#65533;곌껐&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;ㅻ㈃ &#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533; &#65533;ㅽ&#65533;ㅻ&#65533; 諛&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;
遺&#65533;遺&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_proxy.html#proxy">Proxy</a></code>
釉&#65533;濡&#65533;&#65533;&#65533; 理&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/mod_proxy.html#proxyset">ProxySet</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
&#65533;ы&#65533;⑦&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
<p><code class="directive"><a href="../mod/mod_proxy.html#proxypass">ProxyPass</a></code> &#65533;&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/mod_proxy.html#proxypassmatch">ProxyPassMatch</a></code>濡&#65533;
&#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; &#65533;&#65533;援&#65533; &#65533;곌껐&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;ъ&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
</div>

<p>李멸&#65533;: &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;ㅻ㈃
<code class="module"><a href="../mod/mod_proxy.html">mod_proxy</a></code>媛&#65533; &#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_pt" id="flag_pt">PT|passthrough</a> <a title="Permanent link" href="#flag_pt" class="permalink">&para;</a></h2>

<p>
RewriteRule&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;(&#65533;&#65533;&#65533;&#65533; 移&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533;)&#65533;&#65533; 湲곕낯&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;&#65533;
寃쎈&#65533;濡&#65533; 媛&#65533;二쇰&#65533;⑸&#65533;&#65533;&#65533;&#65533;. [PT] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;&#65533;&#65533;&#65533; URI濡&#65533;
泥&#65533;由щ&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 利&#65533;, [PT] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
寃곌낵媛&#65533; URL 留ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;щ&#65533;&#65533;誘&#65533;濡&#65533;,
<code class="directive"><a href="../mod/mod_alias.html#alias">Alias</a></code>,
<code class="directive"><a href="../mod/mod_alias.html#redirect">Redirect</a></code> &#65533;&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/mod_alias.html#scriptalias">ScriptAlias</a></code>&#65533;&#65533; 媛&#65533;&#65533;&#65533;
&#65533;&#65533;移&#65533; 湲곕&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;④낵瑜&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533; 湲고&#65533;&#65533;瑜&#65533; 媛&#65533;吏&#65533;&#65533;&#65533;&#65533;&#65533;.
</p>

<p>
&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, /icons&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/mod_alias.html#alias">Alias</a></code>媛&#65533; &#65533;&#65533;怨&#65533;
嫄곌린瑜&#65533; 媛&#65533;由ы&#65533;ㅻ&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;&#65533;&#65533;ㅻ㈃ <code class="directive"><a href="../mod/mod_alias.html#alias">Alias</a></code>媛&#65533;
&#65533;&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; [PT] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<pre class="prettyprint lang-config">Alias "/icons" "/usr/local/apache/icons"
RewriteRule "/pics/(.+)\.jpg$" "/icons/$1.gif" [PT]</pre>


<p>
&#65533;&#65533; 寃쎌&#65533;&#65533; [PT] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533;&#65533;듯&#65533;&#65533;硫&#65533; Alias媛&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
'File not found' &#65533;ㅻ&#65533;媛&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<p><code>PT</code> &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; <code>L</code> &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;: &#65533;&#65533;泥&#65533;&#65533;&#65533; 泥&#65533;由ъ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;④&#65533;濡&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; 以&#65533;吏&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p><code>PT</code> &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
<code class="directive"><a href="../mod/core.html#directory">&lt;Directory&gt;</a></code>
&#65533;뱀&#65533;&#65533;&#65533;대&#65533;&#65533; <code>.htaccess</code> &#65533;&#65533;&#65533;쇨낵 媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533;
而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;고&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533;
<code>-</code>濡&#65533; &#65533;ъ&#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_qsa" id="flag_qsa">QSA|qsappend</a> <a title="Permanent link" href="#flag_qsa" class="permalink">&para;</a></h2>
<p>
&#65533;&#65533;泥&#65533; URI&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; 寃쎌&#65533;&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
湲곕낯 &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 湲곗〈 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; 踰&#65533;由ш&#65533; &#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;깅&#65533;&#65533; 寃&#65533;&#65533;쇰&#65533;
&#65533;&#65533;泥댄&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. [QSA] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533;
寃고&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<p>&#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteRule "/pages/(.+)" "/page.php?page=$1" [QSA]</pre>


<p>[QSA] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; <code>/pages/123?one=two</code>&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; <code>/page.php?page=123&amp;one=two</code>濡&#65533;
留ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. [QSA] &#65533;&#65533;&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533;
<code>/page.php?page=123</code>&#65533;쇰&#65533; 留ㅽ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533; - 利&#65533;,
湲곗〈 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; 踰&#65533;&#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;.
</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_qsd" id="flag_qsd">QSD|qsdiscard</a> <a title="Permanent link" href="#flag_qsd" class="permalink">&para;</a></h2>
<p>
&#65533;&#65533;泥&#65533;&#65533;&#65533; URI&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;怨&#65533; &#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;, <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
湲곕낯 &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533; 蹂듭&#65533;ы&#65533;&#65533;&#65533;&#65533;
寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. [QSD] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533;
踰&#65533;&#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;.
</p>

<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 踰&#65533;&#65533;&#65533; 2.4.0 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>
[QSD]&#65533;&#65533; [QSA]瑜&#65533; &#65533;④&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; [QSD]媛&#65533; &#65533;곗&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<p>
&#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; 湲곕낯 &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
愿&#65533;李곕&#65533;⑸&#65533;&#65533;&#65533;&#65533; - 利&#65533;, &#65533;&#65533;&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; 踰&#65533;&#65533;ㅼ&#65533;怨&#65533;
<code>RewriteRule</code> &#65533;&#65533;&#65533;&#65533; URI&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;대&#65533;
&#65533;&#65533;泥대&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_qsl" id="flag_qsl">QSL|qslast</a> <a title="Permanent link" href="#flag_qsl" class="permalink">&para;</a></h2>
<p>
湲곕낯&#65533;&#65533;&#65533;쇰&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 泥&#65533; 踰&#65533;吏&#65533;(媛&#65533;&#65533;&#65533; &#65533;쇱そ) 臾쇱&#65533;&#65533;&#65533;&#65533;媛&#65533; 寃쎈&#65533;&#65533;&#65533;
荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; 援щ&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. [QSL] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; 留&#65533;吏&#65533;留&#65533;(媛&#65533;&#65533;&#65533; &#65533;ㅻⅨ履&#65533;) 臾쇱&#65533;&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 援ъ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533;
遺&#65533;由ы&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>
&#65533;닿&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇰&#65533;&#65533;&#65533; 由ы&#65533;곕&#65533;&#65533; 臾쇱&#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 移&#65533;&#65533;&#65533;&#65533;&#65533; 荑쇰━ 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;
&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; &#65533;④&#65533; 臾쇱&#65533;&#65533;&#65533;&#65533;瑜&#65533; 異&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 踰&#65533;&#65533;&#65533; 2.4.19 &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_r" id="flag_r">R|redirect</a> <a title="Permanent link" href="#flag_r" class="permalink">&para;</a></h2>
<p>
[R] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; HTTP 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;멸&#65533;
諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; URL(利&#65533;,
<code>http://servername/</code> &#65533;ы&#65533;&#65533;)&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533;硫&#65533;
&#65533;대&#65533;&#65533; &#65533;&#65533;移&#65533;濡&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;멸&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃
&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;肄&#65533;, &#65533;&#65533;踰&#65533;紐&#65533; 諛&#65533; &#65533;ы&#65533;&#65533; 踰&#65533;&#65533;멸&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몄&#65533;&#65533;
&#65533;④&#65533; &#65533;&#65533;&#65533;〓&#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<p>
&#65533;&#65533;&#65533;⑦&#65533;&#65533; <em>紐⑤&#65533;&#65533;</em> HTTP &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;瑜&#65533;
[R=305] 援щЦ&#65533;쇰&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, 吏&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃
302 &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;媛&#65533; 湲곕낯&#65533;&#65533;&#65533;쇰&#65533; &#65533;ъ&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;媛&#65533;
諛&#65533;&#65533;&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;(3xx) &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
洹몃&#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;媛&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533; 踰&#65533;&#65533;&#65533;(300-399) 諛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇰㈃
移&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; <code>L</code>&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;
寃&#65533;泥&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; 以&#65533;吏&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;&#65533;&#65533; 湲고&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533;瑜&#65533; 吏&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;: <code>temp</code>(湲곕낯媛&#65533;),
<code>permanent</code> &#65533;&#65533;&#65533;&#65533; <code>seeother</code>.</p>

<p>
嫄곗&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; [R]&#65533;&#65533; [L]怨&#65533; &#65533;④&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;怨&#65533; &#65533;띠&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;(利&#65533;,
[R,L]). [R] &#65533;&#65533;&#65533;&#65533;洹&#65533; &#65533;⑤&#65533;&#65533;&#65533;쇰&#65533;&#65533;&#65533; URI &#65533;&#65533;&#65533;&#65533;
<code>http://thishost[:thisport]</code>瑜&#65533; 異&#65533;媛&#65533;&#65533;&#65533;吏&#65533;留&#65533;
&#65533;대&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몄&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;&#65533;&#65533; 醫&#65533;醫&#65533;
'Invalid URI in request' 寃쎄&#65533;瑜&#65533; 珥&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>

<p>李멸&#65533;: httpd&#65533;&#65533; HTTP &#65533;ъ&#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;留&#65533;
吏&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533;
500 &#65533;ㅻ&#65533;&#65533;&#65533; &#65533;ㅻ&#65533; 濡&#65533;洹&#65533; 硫&#65533;&#65533;&#65533;吏&#65533;媛&#65533; 諛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_s" id="flag_s">S|skip</a> <a title="Permanent link" href="#flag_s" class="permalink">&para;</a></h2>
<p>[S] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;띠&#65533; &#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; 嫄대&#65533;&#65533;&#65533;곕&#65533;&#65533; &#65533;&#65533;
&#65533;ъ&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 嫄대&#65533;&#65533;&#65533;곌린 &#65533;&#65533;&#65533;&#65533;洹몄&#65533;&#65533; 援щЦ&#65533;&#65533; [S=<em>N</em>]&#65533;대ŉ,
<em>N</em>&#65533;&#65533; 嫄대&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
(<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>怨&#65533;
&#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code>
吏&#65533;&#65533;&#65533;&#65533;닿&#65533; &#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;). &#65533;닿&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몄&#65533;&#65533;
<code>goto</code> 臾몄&#65533;쇰&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;泥&#65533;&#65533;&#65533; URI媛&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;대&#65533;뱁&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;곗&#65533;&#65533;留&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;
&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config"># Is the request for a non-existent file?
RewriteCond "%{REQUEST_FILENAME}" !-f
RewriteCond "%{REQUEST_FILENAME}" !-d
# If so, skip these two RewriteRules
RewriteRule ".?"                  "-" [S=2]

RewriteRule "(.*\.gif)"           "images.php?$1"
RewriteRule "(.*\.html)"          "docs.php?$1"</pre>


<p>&#65533;&#65533; 湲곗&#65533;&#65533;&#65533;&#65533; <code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code>媛&#65533;
諛&#65533;濡&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;
<code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;留&#65533;
&#65533;&#65533;&#65533;⑸&#65533;&#65533;湲&#65533; &#65533;&#65533;臾몄&#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;곕&#65533;쇱&#65533;&#65533;
<code>RewriteCond</code>瑜&#65533; &#65533;щ&#65533;&#65533;
<code>RewriteRule</code>&#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;&#65533;&#65533;ㅻ㈃ 媛&#65533;&#65533;ν&#65533;&#65533; 湲곗&#65533;&#65533; 以&#65533;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; 議곌굔&#65533;&#65533; 遺&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; [Skip] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; 媛&#65533;吏&#65533;
<code>RewriteRule</code>&#65533;&#65533; 異&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; if-then-else 援ъ“瑜&#65533; 留&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:
then &#65533;&#65533;&#65533;&#65533; 留&#65533;吏&#65533;留&#65533; 洹&#65533;移&#65533;&#65533;&#65533; <code>skip=N</code>&#65533;&#65533; &#65533;&#65533;硫&#65533;,
N&#65533;&#65533; else &#65533;&#65533;&#65533;&#65533; 洹&#65533;移&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;:</p>
<pre class="prettyprint lang-config"># Does the file exist?
RewriteCond "%{REQUEST_FILENAME}" !-f
RewriteCond "%{REQUEST_FILENAME}" !-d
# Create an if-then-else construct by skipping 3 lines if we meant to go to the "else" stanza.
RewriteRule ".?"                  "-" [S=3]

# IF the file exists, then:
    RewriteRule "(.*\.gif)"  "images.php?$1"
    RewriteRule "(.*\.html)" "docs.php?$1"
    # Skip past the "else" stanza.
    RewriteRule ".?"         "-" [S=1]
# ELSE...
    RewriteRule "(.*)"       "404.php?file=$1"
# END</pre>


<p><code class="directive">&lt;If&gt;</code>,
<code class="directive">&lt;ElseIf&gt;</code> 諛&#65533;
<code class="directive">&lt;Else&gt;</code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;硫&#65533; &#65533;대&#65533;ы&#65533;&#65533; 醫&#65533;瑜&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;쎄&#65533; &#65533;ъ&#65533;깊&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_t" id="flag_t">T|type</a> <a title="Permanent link" href="#flag_t" class="permalink">&para;</a></h2>
<p>寃곌낵 &#65533;&#65533;&#65533;듭&#65533;&#65533; &#65533;&#65533;&#65533;〓&#65533;&#65533; MIME &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/mod_mime.html#addtype">AddType</a></code> 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533;
&#65533;&#65533;&#65533;쇳&#65533;&#65533; &#65533;④낵瑜&#65533; 媛&#65533;吏&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;뱀&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; Perl &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;瑜&#65533;
&#65533;쇰&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;몃&#65533; &#65533;&#65533;怨듯&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 湲곗&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;
&#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config"># .pl &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;쇰&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;몃&#65533; &#65533;&#65533;怨&#65533;
RewriteRule "\.pl$"  "-" [T=text/plain]</pre>


<p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;μ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; jpeg &#65533;대&#65533;몄&#65533;瑜&#65533; &#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533; 移대&#65533;&#65533;쇨&#65533;
&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533; 湲곗&#65533;&#65533;쇰&#65533; &#65533;щ&#65533;瑜&#65533; MIME &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;
&#65533;대&#65533;&#65533; &#65533;대&#65533;몄&#65533;媛&#65533; &#65533;&#65533;怨듬&#65533;&#65533;&#65533;&#65533;濡&#65533; 媛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config"># &#65533;대&#65533;&#65533;&#65533; 'IMG'媛&#65533; &#65533;ы&#65533;⑤&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533; jpg &#65533;대&#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
RewriteRule "IMG"  "-" [T=image/jpg]</pre>


<p>&#65533;닿&#65533;&#65533;&#65533; 媛&#65533;&#65533;⑦&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;대ŉ &#65533;&#65533;&#65533;&#65533;
<code class="directive"><a href="../mod/core.html#filesmatch">&lt;FilesMatch&gt;</a></code>瑜&#65533;
&#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
&#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;議댄&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;猷⑥&#65533;&#65533;&#65533;&#65533;
怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;蹂대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;⑥&#65533;⑥&#65533;&#65533;&#65533;&#65533;
&#65533;&#65533;猷⑥&#65533;&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; <em>&#65533;&#65533;泥&#65533;
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;</em>
移&#65533;&#65533;&#65533;&#65533;쇰&#65533; <code>-</code>(&#65533;&#65533;&#65533;&#65533;)留&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.
洹몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;쇰㈃ &#65533;대&#65533; &#65533;ъ&#65533;由&#65533;(&#65533;&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由&#65533; &#65533;쇱&#65533;대&#65533;&#65533; &#65533;ы&#65533;&#65533;)濡&#65533; &#65533;명&#65533;&#65533;
&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; MIME &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅻ&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
<code>L</code> &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533; 而⑦&#65533;&#65533;&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 泥&#65533;由ъ&#65533;&#65533; <em>&#65533;&#65533;&#65533;&#65533;</em> &#65533;쇱&#65533;대&#65533;&#65533;瑜&#65533;
醫&#65533;猷&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_unsafe_allow_3f" id="flag_unsafe_allow_3f">UnsafeAllow3F</a> <a title="Permanent link" href="#flag_unsafe_allow_3f" class="permalink">&para;</a></h2>
    <p>&#65533;&#65533;&#65533;&#65533; 以&#65533;&#65533;&#65533; HTTP &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;&#65533; 臾쇱&#65533;&#65533;&#65533;&#65533; '%3f'媛&#65533; &#65533;&#65533;怨&#65533;
    &#65533;ъ&#65533;&#65533;&#65533;&#65533; 寃곌낵&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; '?'媛&#65533; &#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; 怨&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533;
    &#65533;&#65533;&#65533;⑺&#65533;&#65533;&#65533;ㅻ㈃ &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;몄&#65533;&#65533;⑸&#65533;&#65533;
    臾쇱&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 罹≪&#65533; 諛&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;댁&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; URL濡&#65533;遺&#65533;&#65533;&#65533;
    蹂댄&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_unsafe_prefix_stat" id="flag_unsafe_prefix_stat">UnsafePrefixStat</a> <a title="Permanent link" href="#flag_unsafe_prefix_stat" class="permalink">&para;</a></h2>
    <p>&#65533;&#65533;踰&#65533; 踰&#65533;&#65533;&#65533;&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;李몄“濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533;
    寃쎈&#65533;濡&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    &#65533;대&#65533;ы&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533; 猷⑦&#65533;몃&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;ш&#65533; 遺&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;λ&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;移&#65533; 紐삵&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; &#65533;&#65533;移&#65533;&#65533;&#65533;
    留ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; URL濡&#65533;遺&#65533;&#65533;&#65533; 蹂댄&#65533;명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>Available in Apache HTTP Server 2.5.1 and later.</p>
</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="flag_unc" id="flag_unc">UNC</a> <a title="Permanent link" href="#flag_unc" class="permalink">&para;</a></h2>
    <p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;硫&#65533; Windows UNC 寃쎈&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533;
    &#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;щ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 蹂&#65533;&#65533;⑹&#65533;&#65533; 諛⑹&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹&#65533;移&#65533;&#65533;&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533;
    &#65533;щ&#65533;&#65533; 由ы&#65533;곕&#65533;&#65533; &#65533;щ&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>Available in Apache HTTP Server 2.5.1 and later.</p>
</div></div>
