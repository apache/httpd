<p>&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>
<a href="../mod/mod_rewrite.html">李몄“ 臾몄&#65533;&#65533;</a>瑜&#65533; 蹂댁땐&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; 援ъ&#65533;깅&#65533;&#65533;
媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<div class="warning"><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; 蹂댄&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;
援ъ&#65533;깊&#65533;&#65533;&#65533;&#65533; 理&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. mod_rewrite&#65533;&#65533; &#65533;&#65533;議댄&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533;
癒쇱&#65533;&#65533; <a href="../vhosts/mass.html">&#65533;&#65533;&#65533;&#65533;</a>&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.
"<a href="avoid.html#vhosts">mod_rewrite瑜&#65533; &#65533;쇳&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;</a>"
臾몄&#65533;&#65533;&#65533;&#65533; 李몄“&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</div>

</div>
<div id="quickview"><ul id="toc"><li><img alt="" src="../images/down.gif" /> <a href="#per-hostname">&#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#simple.rewrite"><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533;
    &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#xtra-conf">蹂&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;</a></li>
</ul><h3>참고</h3><ul class="seealso"><li><a href="../mod/mod_rewrite.html">紐⑤&#65533;&#65533; 臾몄&#65533;&#65533;</a></li><li><a href="intro.html">mod_rewrite &#65533;&#65533;媛&#65533;</a></li><li><a href="remapping.html">由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;щℓ&#65533;&#65533;</a></li><li><a href="access.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;</a></li><li><a href="proxy.html">&#65533;&#65533;濡&#65533;&#65533;&#65533;</a></li><li><a href="rewritemap.html">RewriteMap</a></li><li><a href="advanced.html">怨&#65533;湲&#65533; 湲곗&#65533;&#65533;</a></li><li><a href="avoid.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 寃쎌&#65533;&#65533;</a></li><li><a href="#comments_section">Comments</a></li></ul></div>
<div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="per-hostname" id="per-hostname">&#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a> <a title="Permanent link" href="#per-hostname" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
    <p>&#65533;&#65533;濡&#65533;&#65533;&#65533; VirtualHost &#65533;뱀&#65533;&#65533;&#65533;&#65533; 留&#65533;&#65533;ㅼ&#65533; &#65533;&#65533;怨&#65533; &#65533;&#65533;硫&#65533;&#65533;몄&#65533;&#65533;&#65533;&#65533;
    &#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;
    留&#65533;&#65533;ㅺ&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;
    <code><strong>SITE</strong>.example.com</code>&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;怨&#65533;
    <code>/home/<strong>SITE</strong>/www</code>&#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533;
    &#65533;&#65533;怨듯&#65533;&#65533;&#65533;ㅺ&#65533; 媛&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. 洹몃&#65533;щ&#65533;&#65533;
    <code>www.example.com</code>&#65533;&#65533; &#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;&#65533;&#65533;
    &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>

<pre class="prettyprint lang-config">RewriteEngine on

RewriteMap    lowercase int:tolower

RewriteCond   %{HTTP_HOST} !^www\.
RewriteCond   ${lowercase:%{<strong>HTTP_HOST</strong>}}   ^<strong>([^.]+)</strong>\.example\.com$
RewriteRule   ^(.*)    /home/<strong>%1</strong>/www$1</pre>
</dd>

<dt>&#65533;&#65533;濡&#65533;</dt>
    <dd>

    <div class="warning">DNS &#65533;댁&#65533;&#65533;&#65533;&#65533; 吏&#65533;&#65533;&#65533; 愿&#65533;由ы&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533; -
    Apache&#65533;&#65533; &#65533;대&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; 泥&#65533;由ы&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. 媛&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533; CNAME &#65533;&#65533;肄&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; DNS &#65533;&#65533;&#65533;쇰&#65533;&#65533;移대&#65533;&#65533; &#65533;&#65533;肄&#65533;&#65533;&#65533;瑜&#65533;
    留&#65533;&#65533;ㅼ&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. DNS &#65533;&#65533;肄&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; 踰&#65533;&#65533;&#65533;瑜&#65533;
    踰&#65533;&#65533;대&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</div>

<p>&#65533;대&#65533; <code>tolower</code> RewriteMap 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;ъ&#65533;⑸&#65533;&#65533;&#65533;&#65533;
&#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; &#65533;&#65533;臾몄&#65533;&#65533;&#65533;몄&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;깊&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533;
援ъ“&#65533;&#65533; 紐⑦&#65533;명&#65533;⑥&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p><code class="directive"><a href="../mod/mod_rewrite.html#rewritecond">RewriteCond</a></code>&#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;⑸&#65533;&#65533; 愿&#65533;&#65533;몃&#65533;&#65533; &#65533;&#65533;李몄“ <code>%1</code>, <code>%2</code> &#65533;깆&#65533;쇰&#65533;
罹≪&#65533;&#65533;&#65533;硫&#65533;, <code class="directive"><a href="../mod/mod_rewrite.html#rewriterule">RewriteRule</a></code>&#65533;&#65533;&#65533;&#65533;
&#65533;ъ&#65533;⑸&#65533;&#65533; 愿&#65533;&#65533;몃&#65533;&#65533; &#65533;&#65533;李몄“ <code>$1</code>, <code>$2</code> &#65533;깆&#65533;쇰&#65533;
罹≪&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<p>泥&#65533; 踰&#65533;吏&#65533; <code>RewriteCond</code>&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몃&#65533;&#65533;&#65533;
<code>www.</code>濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;, 洹몃&#65533;&#65533;&#65533;ㅻ㈃ &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533;
嫄대&#65533;&#65533;&#65533;곗&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

<p>
&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;쇱&#65533;&#65533;&#65533;&#65533; 留&#65533;&#65533;&#65533; 湲곗&#65533;&#65533;怨&#65533; 留&#65533;李ш&#65533;吏&#65533;濡&#65533;,
<code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;濡&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
理&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_vhost_alias.html">mod_vhost_alias</a></code>
&#65533;ъ&#65533;⑹&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 紐⑤&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;&#65533;&#65533; Alias
&#65533;댁&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;怨&#65533; &#65533;댁&#65533;&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;⑥&#65533;&#65533; &#65533;&#65533; &#65533;곗&#65533;&#65533;&#65533;&#65533;寃&#65533;
泥&#65533;由ы&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
</p>
    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="simple.rewrite" id="simple.rewrite"><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533;
    &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a> <a title="Permanent link" href="#simple.rewrite" class="permalink">&para;</a></h2>

    <p><code>httpd.conf</code>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 諛&#65533;痍&#65533;&#65533;&#65533;
    <a href="#per-hostname">泥&#65533; 踰&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;</a>&#65533;&#65533; &#65533;&#65533;&#65533;쇳&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;諛&#65533;遺&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; 遺&#65533;遺&#65533;怨&#65533; 留ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;ы&#65533;&#65533;吏&#65533;留&#65533;
    &#65533;&#65533;&#65533;&#65533; &#65533;명&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 洹몃━怨&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>
    遺&#65533;遺&#65533;&#65533;&#65533; &#65533;щ&#65533;瑜닿&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;쇰&#65533; 蹂&#65533;寃쎌&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    &#65533;&#65533;諛&#65533;遺&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533;
    <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; 援ъ&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; &#65533;ㅻⅨ URI 蹂&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533;(&#65533;&#65533;:
    <code class="module"><a href="../mod/mod_alias.html">mod_alias</a></code>) &#65533;&#65533;&#65533;&#65533; &#65533;ㅽ&#65533;&#65533;&#65533;&#65533;誘&#65533;濡&#65533;,
    <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533;寃&#65533; 洹몃&#65533;ы&#65533;&#65533; 紐⑤&#65533;&#65533;&#65533;&#65533; 泥&#65533;由ы&#65533;&#65533;&#65533;&#65533;
    URL&#65533;&#65533; 紐&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; 臾댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;
    洹&#65533;移&#65533;&#65533;&#65533; <code>ScriptAlias</code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533; &#65533;고&#65533;&#65533;&#65533;&#65533;誘&#65533;濡&#65533;
    <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>媛&#65533; &#65533;대&#65533;ы&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533; 紐&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533;
    &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;댁&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config"># get the server name from the Host: header
UseCanonicalName Off

# splittable logs
LogFormat "%{Host}i %h %l %u %t \"%r\" %s %b" vcommon
CustomLog "logs/access_log" vcommon

&lt;Directory "/www/hosts"&gt;
    # ExecCGI is needed here because we can't force
    # CGI execution in the way that ScriptAlias does
    Options FollowSymLinks ExecCGI
&lt;/Directory&gt;

RewriteEngine On

# a ServerName derived from a Host: header may be any case at all
RewriteMap  lowercase  "int:tolower"

## deal with normal documents first:
# allow Alias /icons/ to work - repeat for other aliases
RewriteCond  "%{REQUEST_URI}"  "!^/icons/"
# allow CGIs to work
RewriteCond  "%{REQUEST_URI}"  "!^/cgi-bin/"
# do the magic
RewriteRule  "^/(.*)$"         "/www/hosts/${lowercase:%{SERVER_NAME}}/docs/$1"

## and now deal with CGIs - we have to force a handler
RewriteCond  "%{REQUEST_URI}"  "^/cgi-bin/"
RewriteRule  "^/(.*)$"         "/www/hosts/${lowercase:%{SERVER_NAME}}/cgi-bin/$1"  [H=cgi-script]</pre>


</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="xtra-conf" id="xtra-conf">蹂&#65533;&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;</a> <a title="Permanent link" href="#xtra-conf" class="permalink">&para;</a></h2>

    <p>&#65533;&#65533; 諛곗&#65533;&#65533;&#65533; &#65533;&#65533; 怨&#65533;湲&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> 湲곕&#65533;μ&#65533;&#65533;
    &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;
    猷⑦&#65533;몃&#65533;&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;&#65533; 留&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;곗&#65533;깆&#65533;&#65533;
    &#65533;&#65533;怨듯&#65533;&#65533;吏&#65533;留&#65533; &#65533;&#65533; 蹂듭&#65533;≫&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p><code>vhost.map</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;ъ&#65533;&#65533;
    &#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<div class="example"><p><code>
customer-1.example.com  /www/customers/1<br />
customer-2.example.com  /www/customers/2<br />
# ...<br />
customer-N.example.com  /www/customers/N<br />
</code></p></div>

    <p><code>httpd.conf</code>&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;&#65533;댁&#65533;&#65533;
    &#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine on

RewriteMap   lowercase  "int:tolower"

# define the map file
RewriteMap   vhost      "txt:/www/conf/vhost.map"

# deal with aliases as above
RewriteCond  "%{REQUEST_URI}"               "!^/icons/"
RewriteCond  "%{REQUEST_URI}"               "!^/cgi-bin/"
RewriteCond  "${lowercase:%{SERVER_NAME}}"  "^(.+)$"
# this does the file-based remap
RewriteCond  "${vhost:%1}"                  "^(/.*)$"
RewriteRule  "^/(.*)$"                      "%1/docs/$1"

RewriteCond  "%{REQUEST_URI}"               "^/cgi-bin/"
RewriteCond  "${lowercase:%{SERVER_NAME}}"  "^(.+)$"
RewriteCond  "${vhost:%1}"                  "^(/.*)$"
RewriteRule  "^/cgi-bin/(.*)$"                      "%1/cgi-bin/$1" [H=cgi-script]</pre>


</div></div>
