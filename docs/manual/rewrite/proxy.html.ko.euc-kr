<a href="../zh-cn/rewrite/proxy.html" hreflang="zh-cn" rel="alternate" title="Simplified Chinese">&nbsp;zh-cn&nbsp;</a></p>
</div>


<p>&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>
<a href="../mod/mod_rewrite.html">李몄“ 臾몄&#65533;&#65533;</a>瑜&#65533; 蹂댁땐&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
RewriteRule&#65533;&#65533; [P] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ &#65533;&#65533;踰&#65533;濡&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533;
&#65533;&#65533;濡&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;쇰&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;由ъ&#65533;ㅻ&#65533;&#65533; &#65533;ㅻ&#65533;&#65533;&#65533;&#65533;&#65533;
&#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇨&#65533; &#65533;&#65533;怨듬&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

</div>
<div id="quickview"><h3>참고</h3><ul class="seealso"><li><a href="../mod/mod_rewrite.html">紐⑤&#65533;&#65533; 臾몄&#65533;&#65533;</a></li><li><a href="intro.html">mod_rewrite &#65533;&#65533;媛&#65533;</a></li><li><a href="remapping.html">由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;щℓ&#65533;&#65533;</a></li><li><a href="access.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;</a></li><li><a href="vhosts.html">媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li><li><a href="rewritemap.html">RewriteMap &#65533;ъ&#65533;⑺&#65533;&#65533;湲&#65533;</a></li><li><a href="advanced.html">怨&#65533;湲&#65533; 湲곗&#65533;&#65533;</a></li><li><a href="avoid.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 寃쎌&#65533;&#65533;</a></li><li><a href="#comments_section">Comments</a></li></ul></div>
<div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="dynamic-proxy" id="dynamic-proxy">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#dynamic-proxy" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
    <p>
    <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>&#65533;&#65533; [P] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;&#65533;怨듯&#65533;&#65533;&#65533;&#65533;
    <code class="module"><a href="../mod/mod_proxy.html">mod_proxy</a></code>瑜&#65533; &#65533;듯&#65533;&#65533; URL&#65533;&#65533; &#65533;ㅻⅨ &#65533;&#65533;踰&#65533;濡&#65533;
    &#65533;&#65533;&#65533;ы&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;寃&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ш린&#65533;&#65533; &#65533;&#65533; 媛&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; URL&#65533;&#65533; &#65533;ㅻⅨ &#65533;&#65533;踰&#65533;濡&#65533; 吏&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;щ&#65533;&#65533;&#65533;&#65533; 濡&#65533;而&#65533;
    URL&#65533;&#65533; 寃&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;怨듬&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ㅻⅨ &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쎈&#65533;&#65533;
    肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; 諛깆&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533;濡&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>URL&#65533;&#65533; &#65533;ㅻⅨ &#65533;&#65533;踰&#65533;&#65533;&#65533; &#65533;⑥&#65533;&#65533;&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃ &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533;
      [P] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine  on
RewriteBase    "/products/"
RewriteRule    "^widget/(.*)$"  "http://product.example.com/widget/$1"  [P]
ProxyPassReverse "/products/widget/" "http://product.example.com/widget/"</pre>


   <p>&#65533;&#65533; 踰&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 濡&#65533;而ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 李얠&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
   寃쎌&#65533;곗&#65533;&#65533;留&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;닿&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ
   &#65533;&#65533;踰&#65533;濡&#65533; 留&#65533;&#65533;닿렇&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;&#65533;&#65533;쇰ŉ 紐⑤&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;媛&#65533; &#65533;&#65533;吏&#65533;
   留&#65533;&#65533;닿렇&#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 留ㅼ&#65533;&#65533; &#65533;&#65533;&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteCond "%{REQUEST_FILENAME}"       !-f
RewriteCond "%{REQUEST_FILENAME}"       !-d
RewriteRule "^/(.*)"                    "http://old.example.com/$1" [P]
ProxyPassReverse "/" "http://old.example.com/"</pre>

    </dd>

    <dt>&#65533;&#65533;濡&#65533;:</dt>

    <dd><p>媛&#65533; 寃쎌&#65533;곗&#65533;&#65533; 諛깆&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;멸&#65533; &#65533;대&#65533;쇱&#65533;댁&#65533;명&#65533;몄&#65533;&#65533;
    &#65533;щ&#65533;瑜닿&#65533; &#65533;&#65533;&#65533;щ&#65533;&#65533;&#65533;&#65533;濡&#65533; <code class="directive"><a href="../mod/mod_proxy.html#proxypassreverse">ProxyPassReverse</a></code> 吏&#65533;&#65533;&#65533;&#65533;대&#65533;&#65533;
    異&#65533;媛&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

    <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code> &#65533;&#65533;&#65533;&#65533; 媛&#65533;&#65533;ν&#65533;&#65533;硫&#65533;
    <code class="directive"><a href="../mod/mod_proxy.html#proxypass">ProxyPass</a></code> &#65533;&#65533;&#65533;&#65533;
    <code class="directive"><a href="../mod/mod_proxy.html#proxypassmatch">ProxyPassMatch</a></code>瑜&#65533;
    &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>
  </dl>

</div></div>
