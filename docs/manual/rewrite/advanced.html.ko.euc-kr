<li><img alt="" src="../images/down.gif" /> <a href="#redirectanchors">&#65533;듭빱 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#time-dependent">&#65533;&#65533;媛&#65533; 湲곕&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;</a></li>
<li><img alt="" src="../images/down.gif" /> <a href="#setenvvars">URL 遺&#65533;遺&#65533;&#65533;&#65533; &#65533;곕Ⅸ &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;</a></li>
</ul><h3>참고</h3><ul class="seealso"><li><a href="../mod/mod_rewrite.html">紐⑤&#65533;&#65533; 臾몄&#65533;&#65533;</a></li><li><a href="intro.html">mod_rewrite &#65533;&#65533;媛&#65533;</a></li><li><a href="remapping.html">由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;怨&#65533; &#65533;щℓ&#65533;&#65533;</a></li><li><a href="access.html">&#65533;&#65533;洹&#65533; &#65533;&#65533;&#65533;&#65533;</a></li><li><a href="vhosts.html">媛&#65533;&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;&#65533;</a></li><li><a href="proxy.html">&#65533;&#65533;濡&#65533;&#65533;&#65533;</a></li><li><a href="rewritemap.html">RewriteMap &#65533;ъ&#65533;⑺&#65533;&#65533;湲&#65533;</a></li><li><a href="avoid.html">mod_rewrite瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;吏&#65533; 留&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; 寃쎌&#65533;&#65533;</a></li><li><a href="#comments_section">Comments</a></li></ul></div>
<div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="sharding" id="sharding">&#65533;щ&#65533;&#65533; 諛깆&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; URL 湲곕&#65533; &#65533;ㅻ&#65533;&#65533;</a> <a title="Permanent link" href="#sharding" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533;踰&#65533; 遺&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 怨듦&#65533;&#65533;&#65533; 遺&#65533;&#65533;고&#65533;&#65533;&#65533;&#65533; &#65533;쇰&#65533;&#65533;&#65533;&#65533;&#65533; 湲곗&#65533;&#65533;&#65533;&#65533;
      "&#65533;ㅻ&#65533;&#65533;"&#65533;대&#65533;쇨&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;濡&#65533;&#65533;몄&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533;踰&#65533;&#65533;&#65533; URL&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 媛&#65533;泥대&#65533;&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533;
      諛깆&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533; &#65533;쇨&#65533;&#65533;&#65533;寃&#65533; "&#65533;ㅻ&#65533;&#65533;"&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>&#65533;ъ&#65533;⑹&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533;濡&#65533;&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;
      &#65533;&#65533;吏&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;ㅼ&#65533;&#65533;怨&#65533; 媛&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;:</p>

<div class="example"><p><code>
user1  physical_host_of_user1<br />
user2  physical_host_of_user2<br />
# ... &#65533;깅&#65533;&#65533;
</code></p></div>

  <p>&#65533;닿&#65533;&#65533;&#65533; <code>map.users-to-hosts</code> &#65533;&#65533;&#65533;쇱&#65533;&#65533; &#65533;ｌ&#65533;듬&#65533;&#65533;&#65533;&#65533;.
    紐⑹&#65533;&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; 留ㅽ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;;</p>

<div class="example"><p><code>
/u/user1/anypath
</code></p></div>

  <p>&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;쇰&#65533;:</p>

<div class="example"><p><code>
http://physical_host_of_user1/u/user/anypath
</code></p></div>

      <p>&#65533;곕&#65533;쇱&#65533;&#65533; 紐⑤&#65533;&#65533; URL 寃쎈&#65533;媛&#65533; 紐⑤&#65533;&#65533; 諛깆&#65533;&#65533;&#65533;&#65533; 臾쇰━&#65533;&#65533; &#65533;몄&#65533;ㅽ&#65533;몄&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533;&#65533;⑦&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; 留&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;硫&#65533;, &#65533;ъ&#65533;⑹&#65533;&#65533;媛&#65533; 留듭&#65533;&#65533; &#65533;&#65533;紐⑹&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
      寃쎌&#65533;&#65533; server0&#65533;&#65533; 湲곕낯 &#65533;&#65533;踰&#65533;濡&#65533; &#65533;ъ&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine on
RewriteMap    users-to-hosts      "txt:/path/to/map.users-to-hosts"
RewriteRule   "^/u/([^/]+)/?(.*)" "http://${users-to-hosts:$1|server0}/u/$1/$2"</pre>

    </dd>
  </dl>

  <p>&#65533;&#65533; 吏&#65533;&#65533;&#65533;&#65533;댁&#65533;&#65533; 援щЦ&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533; &#65533;댁&#65533;⑹&#65533;&#65533;
  <code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>
  臾몄&#65533;&#65533;&#65533;&#65533; <a href="./rewritemap.html">RewriteMap &#65533;ъ&#65533;⑸&#65533;</a>&#65533;&#65533;
  李몄“&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="on-the-fly-content" id="on-the-fly-content">&#65533;ㅼ&#65533;&#65533;媛&#65533; 肄&#65533;&#65533;&#65533;痢&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#on-the-fly-content" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;깊&#65533;&#65533;&#65533;&#65533;, &#65533;&#65533; 踰&#65533; &#65533;&#65533;&#65533;깅&#65533;&#65533;硫&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;&#65533;ν&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;
      議댁&#65533;щ&#65533;&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533;, &#65533;&#65533;&#65533;쇰㈃ &#65533;&#65533;&#65533;깊&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇱&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533; (&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533; cron&#65533;&#65533; &#65533;듯&#65533;&#65533;) 二쇨린&#65533;&#65533;&#65533;쇰&#65533;
      &#65533;&#65533;嫄고&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;곕&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깅&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      &#65533;대&#65533;&#65533; &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;:

<pre class="prettyprint lang-config"># This example is valid in per-directory context only
RewriteCond "%{REQUEST_URI}"   !-U
RewriteRule "^(.+)\.html$"     "/regenerate_page.cgi"   [PT,L]</pre>


    <p><code>-U</code> &#65533;곗&#65533;곗&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;ㅽ&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533;(&#65533;&#65533; 寃쎌&#65533;&#65533;
    <code>REQUEST_URI</code>)&#65533;&#65533; &#65533;&#65533;&#65533;⑦&#65533;&#65533; URL&#65533;몄&#65533;
    &#65533;&#65533;&#65533;⑦&#65533;⑸&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.
    &#65533;&#65533; &#65533;&#65533;釉&#65533;&#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;ㅽ&#65533;⑦&#65533;&#65533;硫&#65533; - 利&#65533;, &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 議댁&#65533;ы&#65533;&#65533;吏&#65533;
    &#65533;&#65533;&#65533;쇰㈃ - &#65533;&#65533; 洹&#65533;移&#65533;&#65533;&#65533; CGI &#65533;&#65533;濡&#65533;洹몃&#65533;&#65533;
    <code>/regenerate_page.cgi</code>瑜&#65533; &#65533;몄&#65533;&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;깊&#65533;&#65533;怨&#65533; 臾몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533; &#65533;&#65533;&#65533;ν&#65533;&#65533;誘&#65533;濡&#65533;,
    &#65533;ㅼ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; 蹂듭&#65533;щ낯&#65533;&#65533; &#65533;&#65533;怨듯&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    <p>&#65533;&#65533; 諛⑹&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;二&#65533; &#65533;&#65533;&#65533;곗&#65533;댄&#65533;몃&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533; 臾몄&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;怨듯&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. 臾몄&#65533;&#65533;瑜&#65533; &#65533;&#65533;濡&#65533;怨&#65533;移⑦&#65533;댁&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
    寃쎌&#65533;&#65533; 臾몄&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깅&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="load-balancing" id="load-balancing">遺&#65533;&#65533;&#65533; 遺&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#load-balancing" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;щ&#65533;&#65533; &#65533;&#65533;踰&#65533;&#65533;&#65533;
      臾댁&#65533;&#65533;&#65533;&#65533;濡&#65533; 遺&#65533;&#65533;&#65533;瑜&#65533; 遺&#65533;&#65533;고&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p><code class="directive"><a href="../mod/mod_rewrite.html#rewritemap">RewriteMap</a></code>怨&#65533;
      &#65533;&#65533;踰&#65533; 紐⑸&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteEngine on
RewriteMap  lb       "rnd:/path/to/serverlist.txt"
RewriteRule "^/(.*)" "http://${lb:servers}/$1"     [P,L]</pre>


<p><code>serverlist.txt</code>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;踰&#65533; 紐⑸&#65533;&#65533;&#65533; &#65533;ы&#65533;⑤&#65533;⑸&#65533;&#65533;&#65533;&#65533;:</p>

<div class="example"><p><code>
## serverlist.txt<br />
<br />
servers one.example.com|two.example.com|three.example.com<br />
</code></p></div>

<p>&#65533;뱀&#65533;&#65533; &#65533;&#65533;踰&#65533;媛&#65533; &#65533;ㅻⅨ &#65533;&#65533;踰&#65533;蹂대&#65533;&#65533; &#65533;&#65533; 留&#65533;&#65533;&#65533; 遺&#65533;&#65533;&#65533;瑜&#65533; 諛&#65533;&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;ㅻ㈃
紐⑸&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;&#65533;踰&#65533;瑜&#65533; &#65533;&#65533; 留&#65533;&#65533;&#65533; 異&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>

   </dd>

   <dt>&#65533;&#65533;濡&#65533;</dt>
   <dd>
<p>Apache&#65533;&#65533;&#65533;&#65533; 遺&#65533;&#65533;&#65533; 遺&#65533;&#65533;&#65533; 紐⑤&#65533;&#65533;&#65533;&#65533;
<code class="module"><a href="../mod/mod_proxy_balancer.html">mod_proxy_balancer</a></code>媛&#65533; &#65533;ы&#65533;⑤&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ,
&#65533;닿&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 議고&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;
&#65533;대&#65533;&#65533; 寃&#65533;蹂대&#65533;&#65533; &#65533;⑥&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;고&#65533;&#65533;怨&#65533; 湲곕&#65533;μ&#65533;&#65533; &#65533;&#65533;遺&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
   </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="structuredhomedirs" id="structuredhomedirs">援ъ“&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533;</a> <a title="Permanent link" href="#structuredhomedirs" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533;泥&#65533; 紐&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;&#65533; &#65533;쇰&#65533; &#65533;ъ&#65533;댄&#65533;몃&#65533;&#65533; 援ъ“&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;. <em>利&#65533;,</em> 媛&#65533;
      &#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533; &#65533;대&#65533;&#65533;&#65533; 泥&#65533; 踰&#65533;吏&#65533; 臾몄&#65533;&#65533;濡&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由ъ&#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;
      <code>/~larry/anypath</code>&#65533;&#65533;
      <code>/home/<strong>l</strong>/larry/public_html/anypath</code>&#65533;닿&#65533;
      <code>/~waldo/anypath</code>&#65533;&#65533;
      <code>/home/<strong>w</strong>/waldo/public_html/anypath</code>&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; 臾쇨껐&#65533;&#65533; URL&#65533;&#65533; &#65533;&#65533;&#65533;ν&#65533;&#65533;湲&#65533; &#65533;&#65533;&#65533;&#65533;
      &#65533;ㅼ&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteEngine on
RewriteRule   "^/~(<strong>([a-z])</strong>[a-z0-9]+)(.*)"  "/home/<strong>$2</strong>/$1/public_html$3"</pre>

    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="redirectanchors" id="redirectanchors">&#65533;듭빱 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#redirectanchors" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
    <p>湲곕낯&#65533;&#65533;&#65533;쇰&#65533; HTML &#65533;듭빱濡&#65533;&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;吏&#65533;
    &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>媛&#65533; <code>#</code>
    臾몄&#65533;&#65533;瑜&#65533; &#65533;댁&#65533;ㅼ&#65533;&#65533;댄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; <code>%23</code>&#65533;쇰&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533;湲&#65533;
    &#65533;&#65533;臾몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533; &#65533;명&#65533;&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 以&#65533;&#65533;⑤&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p><code>RewriteRule</code>&#65533;&#65533; <code>[NE]</code>
      &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;⑸&#65533;&#65533;&#65533;&#65533;. NE&#65533;&#65533; No Escape瑜&#65533; &#65533;&#65533;誘명&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;&#65533;濡&#65533;:</dt>
    <dd>&#65533;&#65533; 湲곗&#65533;&#65533;&#65533;&#65533; <code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>媛&#65533; 湲곕낯&#65533;&#65533;&#65533;쇰&#65533;
    URL &#65533;몄&#65533;&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;ㅻⅨ &#65533;뱀&#65533;&#65533; 臾몄&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 臾쇰&#65533; &#65533;&#65533;&#65533;⑸&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="time-dependent" id="time-dependent">&#65533;&#65533;媛&#65533; 湲곕&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533;</a> <a title="Permanent link" href="#time-dependent" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p><code class="module"><a href="../mod/mod_rewrite.html">mod_rewrite</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;곕&#65533;&#65533;
      &#65533;ㅻⅨ 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;&#65533;怨듯&#65533;&#65533;怨&#65533;&#65533;&#65533; &#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>&#65533;ъ&#65533;&#65533;&#65533;&#65533; 議곌굔&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;&#65533; <code>TIME_xxx</code>&#65533;쇰&#65533;&#65533;
      留&#65533;&#65533;&#65533; 蹂&#65533;&#65533;&#65533;媛&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;뱀&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;&#65533; 鍮&#65533;援&#65533; &#65533;⑦&#65533;&#65533;
      <code>&lt;STRING</code>, <code>&gt;STRING</code>,
      <code>=STRING</code>怨&#65533; &#65533;④&#65533; &#65533;&#65533;媛&#65533; 湲곕&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteEngine on
RewriteCond   "%{TIME_HOUR}%{TIME_MIN}" &gt;0700
RewriteCond   "%{TIME_HOUR}%{TIME_MIN}" &lt;1900
RewriteRule   "^foo\.html$"             "foo.day.html" [L]
RewriteRule   "^foo\.html$"             "foo.night.html"</pre>


      <p>&#65533;닿&#65533;&#65533;&#65533; <code>07:01-18:59</code> &#65533;ъ&#65533;댁&#65533;&#65533;&#65533;&#65533; URL
      <code>foo.html</code> &#65533;&#65533;&#65533;&#65533; <code>foo.day.html</code>&#65533;&#65533;
      肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;&#65533;怨듯&#65533;&#65533;怨&#65533;, &#65533;&#65533;癒몄&#65533; &#65533;&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533;
      <code>foo.night.html</code>&#65533;&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;&#65533;怨듯&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

      <div class="warning"><code class="module"><a href="../mod/mod_cache.html">mod_cache</a></code>, 以&#65533;媛&#65533; &#65533;&#65533;濡&#65533;&#65533;&#65533;
      諛&#65533; 釉&#65533;&#65533;쇱&#65533;곗&#65533;&#65533;&#65533;&#65533; 媛&#65533;媛&#65533; &#65533;&#65533;&#65533;듭&#65533;&#65533; 罹&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;쇰ŉ, 援ъ&#65533;깅&#65533;&#65533;
      &#65533;&#65533;媛&#65533; 李&#65533; 諛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; 履&#65533; &#65533;&#65533;&#65533;댁&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.
      <code class="module"><a href="../mod/mod_expires.html">mod_expires</a></code>瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;④낵瑜&#65533;
      &#65533;&#65533;&#65533;댄&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. 臾쇰&#65533; 肄&#65533;&#65533;&#65533;痢&#65533;瑜&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;쇰&#65533; &#65533;&#65533;怨듯&#65533;&#65533;怨&#65533;
      &#65533;&#65533;媛&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;곕&#65533;&#65533; &#65533;ъ&#65533;⑹&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; &#65533;⑥&#65533;&#65533; 醫&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</div>

    </dd>
  </dl>

</div><div class="top"><a href="#page-header"><img alt="top" src="../images/up.gif" /></a></div>
<div class="section">
<h2><a name="setenvvars" id="setenvvars">URL 遺&#65533;遺&#65533;&#65533;&#65533; &#65533;곕Ⅸ &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;</a> <a title="Permanent link" href="#setenvvars" class="permalink">&para;</a></h2>

  

  <dl>
    <dt>&#65533;ㅻ&#65533;:</dt>

    <dd>
      <p>&#65533;&#65533;&#65533;&#65533;濡&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;대&#65533;&#65533; 醫&#65533;瑜&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;瑜&#65533;
      &#65533;&#65533;吏&#65533;&#65533;&#65533;怨&#65533; &#65533;띠&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;, &#65533;대&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533;
      &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ&#65533;&#65533; 寃&#65533;&#65533;&#65533; 湲곕&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;以&#65533;&#65533;&#65533; &#65533;&#65533;泥&#65533;&#65533;&#65533; &#65533;대&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533;
      &#65533;듯&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533;怨&#65533; &#65533;띠&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;대&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
      &#65533;&#65533; 媛&#65533;吏&#65533; 諛⑸&#65533;&#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;.</p>
    </dd>

    <dt>&#65533;닿껐梨&#65533;:</dt>

    <dd>
      <p>[E] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;⑸&#65533;&#65533;&#65533;&#65533;.</p>

<pre class="prettyprint lang-config">RewriteEngine on
RewriteRule   "^/horse/(.*)"   "/pony/$1" [E=<strong>rewritten:1</strong>]</pre>


    <p>&#65533;&#65533;以&#65533;&#65533;&#65533; 洹&#65533;移&#65533; &#65533;명&#65533;몄&#65533;&#65533;&#65533;&#65533; RewriteCond瑜&#65533; &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533;
    &#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;瑜&#65533; &#65533;&#65533;&#65533;명&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;:</p>

<pre class="prettyprint lang-config">RewriteCond "%{ENV:rewritten}"  =1</pre>


    <p>&#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;몃&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몄&#65533;&#65533;&#65533;&#65533; &#65533;&#65533;吏&#65533;&#65533;&#65533;吏&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;ㅻ&#65533;&#65533;
    &#65533;&#65533;&#65533;&#65533; &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;. 荑&#65533;&#65533;ㅻ&#65533;&#65533; &#65533;ㅼ&#65533;&#65533;&#65533;&#65533;&#65533;ㅻ㈃ [CO] &#65533;&#65533;&#65533;&#65533;洹몃&#65533;&#65533;
    &#65533;ъ&#65533;⑺&#65533;&#65533;&#65533;&#65533; 寃&#65533;&#65533;&#65533; 怨&#65533;&#65533;ㅽ&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;. &#65533;&#65533;&#65533;&#65533;&#65533;&#65533;由щ&#65533; 諛&#65533;
    htaccess &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533;&#65533;&#65533; 理&#65533;醫&#65533; 移&#65533;&#65533;&#65533;&#65533;&#65533; &#65533;대&#65533; 由щ&#65533;ㅼ&#65533;대&#65533;&#65533;&#65533;몃&#65533;
    泥&#65533;由щ&#65533;&#65533;&#65533;&#65533; 寃쎌&#65533;&#65533;, &#65533;댁&#65533;&#65533; &#65533;쇱&#65533;대&#65533;&#65533;&#65533;&#65533; &#65533;ъ&#65533;&#65533;&#65533;깆&#65533;&#65533;&#65533;&#65533; &#65533;&#65533; &#65533;&#65533;寃&#65533; 蹂&#65533;&#65533;&#65533;&#65533;&#65533;
    "REDIRECT_" &#65533;&#65533;&#65533;&#65533;&#65533;ш&#65533; 遺&#65533;&#65533;듬&#65533;&#65533;&#65533;&#65533;.</p>

    </dd>
  </dl>

