<table class="module"><tr><th><a href="module-dict.html#Description">Description:</a></th><td>Gestion des jetons de base</td></tr>
<tr><th><a href="module-dict.html#Status">Statut:</a></th><td>Base</td></tr>
<tr><th><a href="module-dict.html#ModuleIdentifier">Identificateur&nbsp;de&nbsp;Module:</a></th><td>autht_core_module</td></tr>
